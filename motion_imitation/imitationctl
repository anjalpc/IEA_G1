#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: ./motion_imitation/imitationctl <command>

Commands:
  status      Show imitation reference/run status (CPU only)
  preflight   Run canonical reference contract audit (CPU only)
  test        Run imitation reference unit tests (CPU only)
  reference   Alias for preflight
  isaac-preflight  Run one-env Isaac plant/alignment gate (no training)
  help        Show this help

Training/evaluation commands will be added only after their contracts pass.
This controller does not manage or stop the pure-RL stair process.
EOF
}

command="${1:-help}"

case "$command" in
    status)
        exec python3 "$ROOT/scripts/diagnostics/status.py"
        ;;
    preflight|reference)
        exec python3 "$ROOT/scripts/diagnostics/preflight.py"
        ;;
    isaac-preflight)
        exec "$ROOT/scripts/diagnostics/run_isaac_preflight.sh"
        ;;
    test)
        cd "$ROOT/.."
        exec python3 -m unittest discover \
          -s motion_imitation/tests \
          -p 'test_*.py' \
          -v
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $command" >&2
        echo >&2
        usage >&2
        exit 2
        ;;
esac
