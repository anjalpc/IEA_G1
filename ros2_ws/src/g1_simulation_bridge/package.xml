<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_simulation_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 adapter between G1 applications and MuJoCo simulation.</description>
  <maintainer email="anjal-mohammed.pothuvachola@telefonica.com">Anjal Mohammed Pothuvachola</maintainer>
  <license>Proprietary</license>

  <exec_depend>g1_robot_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
