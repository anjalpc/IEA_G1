#!/usr/bin/env bash
set -euo pipefail

REPO="/home/ubuntu/workspace/IEA_G1"
WORKSPACE="/home/ubuntu/workspace"

EXPERIMENT_ROOT="${REPO}/experiments/g1_stairs"
RUN_ROOT="${EXPERIMENT_ROOT}/runs"
LOG_ROOT="${EXPERIMENT_ROOT}/logs"
OUTPUT_ROOT="${EXPERIMENT_ROOT}/outputs"
STATE_DIR="${WORKSPACE}/state/IEA_G1"
LAUNCHER_LOG_DIR="${STATE_DIR}/launcher_logs"
CURRENT_RUN="${STATE_DIR}/current_run"
CURRENT_PID="${STATE_DIR}/current_pid"
TRAIN_WRAPPER="${REPO}/simulation/isaac_lab/g1_stairs/scripts/training/run_aws_recorded_experiment.sh"
TB_PORT=6006
CONTAINER="isaac-lab-fixed"

ensure_state_dirs() {
    mkdir -p "$STATE_DIR" "$LAUNCHER_LOG_DIR"
}

cd "$REPO"

usage() {
    cat <<USAGE
Usage:
  simctl train <config.yaml>
  simctl stop
  simctl status [--all]          (--all: every reward term and episode ending)
  simctl diagnose
  simctl mechanics
  simctl health [--json]
  simctl info
  simctl runs
  simctl use <run_id>
  simctl tensorboard {start|status|stop}
  simctl video <checkpoint> [--height <m>] [--seed <n>] [--trace-only] [--markers]
  simctl traces [<checkpoint>...] [--parallel <n>] [--name <tag>] [--symmetry check|average]   (trace batch + pass/fail report + tarball)
  simctl showcase <checkpoint> [--robots <n>] [--rows <n>] [--seconds <s>] [--height <m>] [--seed <n>] [--no-markers]
  simctl baseline [config.yaml]
  simctl evaluate <checkpoint>
  simctl help
USAGE
}

ensure_container_running() {
    if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
        echo "Required container does not exist: $CONTAINER" >&2
        echo "Refusing to recreate it automatically." >&2
        exit 1
    fi

    RUNNING="$(
        docker inspect \
          --format '{{.State.Running}}' \
          "$CONTAINER"
    )"

    if [ "$RUNNING" != "true" ]; then
        echo "Starting container: $CONTAINER"

        docker start "$CONTAINER" >/dev/null

        for _ in {1..10}; do
            RUNNING="$(
                docker inspect \
                  --format '{{.State.Running}}' \
                  "$CONTAINER"
            )"

            if [ "$RUNNING" = "true" ]; then
                echo "Container running."
                return 0
            fi

            sleep 1
        done

        echo "Container failed to start: $CONTAINER" >&2
        exit 1
    fi
}

current_run() {
    if [ ! -f "$CURRENT_RUN" ]; then
        echo "No current training run recorded." >&2
        exit 1
    fi
    cat "$CURRENT_RUN"
}

train_dir_to_host() {
    local train_dir="$1"

    case "$train_dir" in
        /workspace/IEA_G1/experiments/g1_stairs/logs/*)
            echo "${train_dir/\/workspace\/IEA_G1/$REPO}"
            ;;
        /workspace/IEA_G1/logs/*)
            local relative="${train_dir#/workspace/IEA_G1/logs/}"
            echo "${LOG_ROOT}/${relative}"
            ;;
        *)
            echo "Unsupported training directory: $train_dir" >&2
            return 1
            ;;
    esac
}

cmd_runs() {
    echo "========================================"
    echo " AVAILABLE RECORDED RUNS"
    echo "========================================"

    CURRENT=""
    if [ -f "$CURRENT_RUN" ]; then
        CURRENT="$(cat "$CURRENT_RUN")"
    fi

    found=0

    for dir in "$RUN_ROOT"/*; do
        [ -d "$dir" ] || continue

        run_id="$(basename "$dir")"
        manifest="$dir/run_manifest.yaml"

        if [ -f "$manifest" ]; then
            status="$(
                grep -E '^  status:' "$manifest" \
                | tail -n 1 \
                | sed 's/^  status:[[:space:]]*//' \
                || true
            )"
        else
            status="unknown"
        fi

        marker=" "
        if [ "$run_id" = "$CURRENT" ]; then
            marker="*"
        fi

        printf "%s %-55s %s\n" "$marker" "$run_id" "${status:-unknown}"
        found=1
    done

    if [ "$found" -eq 0 ]; then
        echo "No recorded runs found."
    fi

    echo
    echo "* = currently selected run"
}

cmd_use() {
    if [ $# -ne 1 ]; then
        echo "Usage: simctl use <run_id>"
        exit 1
    fi

    RUN_ID="$1"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"

    if [ ! -d "$RUN_DIR" ]; then
        echo "Run not found:"
        echo "  $RUN_DIR"
        echo
        echo "Use 'simctl runs' to list available runs."
        exit 1
    fi

    ensure_state_dirs
    printf '%s\n' "$RUN_ID" > "$CURRENT_RUN"

    echo "Selected run:"
    echo "  $RUN_ID"
    echo
    echo "Commands such as status, video and evaluate now use this run."
}

cmd_train() {
    if [ $# -lt 1 ]; then
        echo "Missing experiment config."
        usage
        exit 1
    fi

    CONFIG="$1"

    if [ ! -f "$CONFIG" ]; then
        echo "Config not found: $CONFIG"
        exit 1
    fi

    if [ -n "$(git status --porcelain)" ]; then
        echo "Refusing to train from a dirty worktree."
        git status --short
        exit 1
    fi

    ensure_container_running

    BASE="$(basename "$CONFIG" .yaml)"
    RUN_ID="${BASE}_$(date -u +%Y%m%d_%H%M%S)"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    ensure_state_dirs
    printf '%s\n' "$RUN_ID" > "$CURRENT_RUN"

    echo "========================================"
    echo " G1 STAIR TRAINING"
    echo "========================================"
    echo "Config: $CONFIG"
    echo "Run:    $RUN_ID"
    echo "Log:    $LOG"
    echo

    nohup "$TRAIN_WRAPPER" \
        "$CONFIG" \
        --run-id "$RUN_ID" \
        > "$LOG" 2>&1 &

    PID=$!

    echo "$PID" > "$CURRENT_PID"

    echo "Started."
    echo "PID: $PID"
    echo
    echo "Use:"
    echo "  simulation/isaac_lab/g1_stairs/scripts/simctl status"
}

cmd_stop() {
    ensure_state_dirs

    local RUN_ID=""
    local LAUNCHER_PID=""
    local TRAIN_PIDS=""
    local LEFT=""

    if [ -f "$CURRENT_RUN" ]; then
        RUN_ID="$(cat "$CURRENT_RUN")"
    fi

    if [ -f "$CURRENT_PID" ]; then
        LAUNCHER_PID="$(cat "$CURRENT_PID")"
    fi

    echo "========================================"
    echo " STOP G1 STAIR TRAINING"
    echo "========================================"

    if [ -n "$RUN_ID" ]; then
        echo "Run: $RUN_ID"
    else
        echo "Run: not recorded"
    fi

    # Stop the actual Isaac/RSL-RL process inside the persistent container.
    # The PID stored by simctl belongs to the host-side launcher wrapper, not
    # necessarily the final Python training process.
    if docker inspect "$CONTAINER" >/dev/null 2>&1; then
        if [ "$(
            docker inspect \
              --format '{{.State.Running}}' \
              "$CONTAINER"
        )" = "true" ]; then

            TRAIN_PIDS="$(
                docker exec "$CONTAINER" bash -lc '
                    ps -eo pid,args \
                    | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
                ' || true
            )"

            if [ -n "$TRAIN_PIDS" ]; then
                echo "Training PID(s) in container: $TRAIN_PIDS"
                echo "Sending SIGTERM..."

                docker exec "$CONTAINER" bash -lc "
                    kill -TERM $TRAIN_PIDS
                "

                for _ in {1..10}; do
                    sleep 1

                    LEFT="$(
                        docker exec "$CONTAINER" bash -lc '
                            ps -eo pid,args \
                            | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
                        ' || true
                    )"

                    if [ -z "$LEFT" ]; then
                        break
                    fi
                done

                if [ -n "$LEFT" ]; then
                    echo "Still running after SIGTERM: $LEFT"
                    echo "Sending SIGKILL..."

                    docker exec "$CONTAINER" bash -lc "
                        kill -KILL $LEFT
                    "
                fi
            else
                echo "No active run_isaac_stairs.py train process found."
            fi
        else
            echo "Container is not running."
        fi
    else
        echo "Container does not exist: $CONTAINER"
    fi

    # Also stop the host launcher wrapper if it survived after the child
    # training process exited.
    if [ -n "$LAUNCHER_PID" ] \
       && [[ "$LAUNCHER_PID" =~ ^[0-9]+$ ]] \
       && kill -0 "$LAUNCHER_PID" 2>/dev/null; then

        echo "Stopping launcher PID: $LAUNCHER_PID"
        kill -TERM "$LAUNCHER_PID" 2>/dev/null || true

        for _ in {1..5}; do
            if ! kill -0 "$LAUNCHER_PID" 2>/dev/null; then
                break
            fi
            sleep 1
        done

        if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
            echo "Launcher still alive; sending SIGKILL."
            kill -KILL "$LAUNCHER_PID" 2>/dev/null || true
        fi
    fi

    rm -f "$CURRENT_PID"

    LEFT=""

    if docker inspect "$CONTAINER" >/dev/null 2>&1 \
       && [ "$(
           docker inspect \
             --format '{{.State.Running}}' \
             "$CONTAINER"
       )" = "true" ]; then

        LEFT="$(
            docker exec "$CONTAINER" bash -lc '
                ps -eo pid,args \
                | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
            ' || true
        )"
    fi

    if [ -n "$LEFT" ]; then
        echo "ERROR: training process is still running: $LEFT" >&2
        return 1
    fi

    echo "Training stopped."
}

cmd_diagnose() {
    local RUN_ID
    local RUN_DIR
    local CONTAINER_RUN_DIR
    local REPORT_SCRIPT

    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"

    CONTAINER_RUN_DIR="/workspace/IEA_G1/experiments/g1_stairs/runs/${RUN_ID}"
    REPORT_SCRIPT="/workspace/IEA_G1/simulation/isaac_lab/g1_stairs/scripts/diagnostics/build_run_diagnostic_report.py"

    echo "========================================"
    echo " G1 STAIR DIAGNOSTICS"
    echo "========================================"
    echo "Run: $RUN_ID"
    echo

    if [ ! -d "$RUN_DIR" ]; then
        echo "Run directory not found:" >&2
        echo "  $RUN_DIR" >&2
        return 1
    fi

    ensure_container_running

    if ! docker exec \
        "$CONTAINER" \
        test -f "$REPORT_SCRIPT"
    then
        echo "Diagnostic report script not found in container:" >&2
        echo "  $REPORT_SCRIPT" >&2
        return 1
    fi

    docker exec \
        --workdir /workspace/IEA_G1 \
        "$CONTAINER" \
        /workspace/isaaclab/_isaac_sim/python.sh \
        "$REPORT_SCRIPT" \
        "$CONTAINER_RUN_DIR"

    if [ ! -f "$RUN_DIR/diagnostic_summary.json" ]; then
        echo "Diagnostic summary was not generated:" >&2
        echo "  $RUN_DIR/diagnostic_summary.json" >&2
        return 1
    fi

    if [ ! -f "$RUN_DIR/diagnostic_report.md" ]; then
        echo "Diagnostic report was not generated:" >&2
        echo "  $RUN_DIR/diagnostic_report.md" >&2
        return 1
    fi

    echo
    echo "========================================"
    echo " DIAGNOSTIC REPORT"
    echo "========================================"
    echo

    cat "$RUN_DIR/diagnostic_report.md"

    echo
    echo "========================================"
    echo " OUTPUTS"
    echo "========================================"
    echo "$RUN_DIR/diagnostic_summary.json"
    echo "$RUN_DIR/diagnostic_report.md"
}


cmd_mechanics() {
    local RUN_ID
    local RUN_DIR
    local RESOLVED
    local OUTPUT_DIR
    local CONTAINER_RESOLVED
    local CONTAINER_OUTPUT
    local SCRIPT
    local ACTIVE

    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"
    RESOLVED="${RUN_DIR}/resolved_config.yaml"
    OUTPUT_DIR="${RUN_DIR}/mechanics_qualification"
    CONTAINER_RESOLVED="/workspace/IEA_G1/experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"
    CONTAINER_OUTPUT="/workspace/IEA_G1/experiments/g1_stairs/runs/${RUN_ID}/mechanics_qualification"
    SCRIPT="/workspace/IEA_G1/simulation/isaac_lab/g1_stairs/scripts/diagnostics/qualify_single_support.py"

    if [ ! -f "$RESOLVED" ]; then
        echo "Resolved config not found:" >&2
        echo "  $RESOLVED" >&2
        return 1
    fi

    ensure_container_running

    ACTIVE="$(
        docker exec "$CONTAINER" bash -lc '
            ps -eo pid,args \
            | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
        ' || true
    )"

    if [ -n "$ACTIVE" ]; then
        echo "Refusing mechanics qualification while training is active:" >&2
        echo "  PID(s): $ACTIVE" >&2
        echo "Stop the run first with: simctl stop" >&2
        return 1
    fi

    rm -rf "$OUTPUT_DIR"

    echo "========================================"
    echo " G1 SINGLE-SUPPORT MECHANICS"
    echo "========================================"
    echo "Run: $RUN_ID"
    echo "Policy: NONE"
    echo "Rewards: DISABLED"
    echo

    docker exec \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      --env UNITREE_MODEL_ROOT=/workspace/unitree_model \
      --workdir /workspace/IEA_G1 \
      "$CONTAINER" \
      /workspace/isaaclab/isaaclab.sh -p \
      "$SCRIPT" \
      --task Unitree-IEA-G1-29dof-Stairs-v0 \
      --resolved-config "$CONTAINER_RESOLVED" \
      --output-dir "$CONTAINER_OUTPUT" \
      --seed 42 \
      --headless \
      --device cuda:0

    if [ ! -f "$OUTPUT_DIR/mechanics_report.txt" ]; then
        echo "Mechanics report was not generated:" >&2
        echo "  $OUTPUT_DIR/mechanics_report.txt" >&2
        return 1
    fi

    echo
    cat "$OUTPUT_DIR/mechanics_report.txt"
}


cmd_health() {
    local RUN_ID
    local RUN_DIR
    local HEALTH_SCRIPT

    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"
    HEALTH_SCRIPT="${REPO}/simulation/isaac_lab/g1_stairs/scripts/diagnostics/reward_health.py"

    if [ ! -d "$RUN_DIR" ]; then
        echo "Run directory not found:" >&2
        echo "  $RUN_DIR" >&2
        return 1
    fi

    if [ ! -f "$HEALTH_SCRIPT" ]; then
        echo "Health script not found:" >&2
        echo "  $HEALTH_SCRIPT" >&2
        return 1
    fi

    # Host-side only: reading the append-only CSV evidence must never touch
    # or pause the active Isaac/RSL-RL process.
    python3 "$HEALTH_SCRIPT" "$RUN_DIR" "$@"
}

cmd_status() {
    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"
    MANIFEST="${RUN_DIR}/run_manifest.yaml"
    METRICS="${RUN_DIR}/training_metrics.csv"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    echo "========================================"
    echo " G1 TRAINING STATUS"
    echo "========================================"
    echo "Run: $RUN_ID"

    if [ -f "$MANIFEST" ]; then
        STATUS="$(grep -E '^  status:' "$MANIFEST" | tail -n 1 | sed 's/^  status:[[:space:]]*//')"
        EXIT_CODE="$(grep -E '^  exit_code:' "$MANIFEST" | tail -n 1 | sed 's/^  exit_code:[[:space:]]*//' || true)"
        echo "Status: ${STATUS:-unknown}"
        [ -n "${EXIT_CODE:-}" ] && echo "Exit code: $EXIT_CODE"
    else
        echo "Status: starting"
    fi

    if [ -f "$METRICS" ]; then
        python3 - "$METRICS" "${RUN_DIR}/resolved_config.yaml" "${RUN_DIR}/reward_components.csv" "$LOG" <<'STATUS_PY'
import csv
import math
import re
import sys
from pathlib import Path

metrics_path, resolved_path, rewards_path, log_path = (Path(a) for a in sys.argv[1:5])


def read_csv(path):
    if not path.is_file():
        return []
    with path.open(newline="") as stream:
        return list(csv.DictReader(stream))


def num(row, key):
    try:
        value = float(row.get(key, ""))
    except (TypeError, ValueError):
        return None
    return value if math.isfinite(value) else None


def hms(seconds):
    seconds = int(max(seconds, 0))
    return f"{seconds // 3600}h {seconds % 3600 // 60:02d}m {seconds % 60:02d}s"


rows = read_csv(metrics_path)
max_iterations = None
if resolved_path.is_file():
    try:
        import yaml
        resolved = yaml.safe_load(resolved_path.read_text(encoding="utf-8")) or {}
        max_iterations = int(resolved["execution"]["maximum_iterations"])
    except Exception:
        max_iterations = None

print()
print("PROGRESS")
if rows:
    last = rows[-1]
    iteration = int(float(last.get("iteration") or 0))
    wall = num(last, "wall_time_s")
    # A resumed run starts counting at its checkpoint's next iteration.
    start = int(float(rows[0].get("iteration") or 0))
    done = iteration + 1 - start
    if max_iterations:
        frac = min(done / max_iterations, 1.0)
        bar = "#" * int(frac * 30) + "-" * (30 - int(frac * 30))
        print(f"  Iteration:  {iteration} / {start + max_iterations - 1}  [{bar}] {100 * frac:5.1f}%")
    else:
        print(f"  Iteration:  {iteration} (maximum not found in resolved config)")
    if wall is not None and done > 0:
        per_iteration = wall / done
        print(f"  Elapsed:    {hms(wall)}   ({per_iteration:.1f} s / iteration)")
        if max_iterations:
            print(f"  Remaining:  ~{hms(per_iteration * (max_iterations - done))}")
    steps_per_s = num(last, "environment_steps_per_second")
    if steps_per_s:
        print(f"  Env steps/s: {steps_per_s:,.0f}")
else:
    print("  Training metrics: NOT RECORDED yet")

STATUS_PY
    fi
    python3 "${REPO}/simulation/isaac_lab/g1_stairs/scripts/evaluation/training_status.py" "$RUN_DIR" "$LOG" "$@" || true

    echo
    echo "Latest checkpoint:"

    TRAIN_DIR="$(resolve_train_dir 2>/dev/null || true)"

    if [ -n "$TRAIN_DIR" ] && [ -d "$TRAIN_DIR" ]; then
        LATEST_CHECKPOINT="$(
            find "$TRAIN_DIR" -maxdepth 1 -type f -name 'model_*.pt' \
                2>/dev/null \
                | sed -E 's/.*model_([0-9]+)\.pt/\1 &/' \
                | sort -n \
                | tail -n 1 \
                | cut -d' ' -f2- || true
        )"

        if [ -n "$LATEST_CHECKPOINT" ]; then
            echo "$LATEST_CHECKPOINT"
        else
            echo "No checkpoint found yet."
        fi
    else
        echo "Not resolved yet."
    fi

    echo
    if curl -fsS --max-time 1 "http://127.0.0.1:${TB_PORT}/" >/dev/null 2>&1; then
        echo "TensorBoard: running on AWS port ${TB_PORT} (open the local address VS Code shows for it)"
    else
        echo "TensorBoard: not running"
        echo "Start with: simctl tensorboard start"
    fi
    echo "========================================"
}

tensorboard_is_running() {
    curl -fsS --max-time 1 \
        "http://127.0.0.1:${TB_PORT}/" \
        >/dev/null 2>&1
}

cmd_tensorboard() {
    local action="${1:-status}"

    case "$action" in
        start)
            ensure_container_running

            if tensorboard_is_running; then
                echo "TensorBoard already running."
                echo "Open: http://localhost:${TB_PORT}"
                return 0
            fi

            echo "Starting TensorBoard..."

            docker exec -d \
                "$CONTAINER" \
                bash -lc "
                exec /workspace/isaaclab/isaaclab.sh -p -m tensorboard.main \
                  --logdir /workspace/IEA_G1/experiments/g1_stairs/logs/rsl_rl \
                  --host 127.0.0.1 \
                  --port ${TB_PORT} \
                  > /tmp/tensorboard.log 2>&1
                "

            for _ in {1..10}; do
                if tensorboard_is_running; then
                    echo "TensorBoard started."
                    echo "Open: http://localhost:${TB_PORT}"
                    return 0
                fi
                sleep 1
            done

            echo "TensorBoard failed to start." >&2
            echo "Container log:" >&2
            docker exec "$CONTAINER" \
                tail -n 40 /tmp/tensorboard.log 2>/dev/null || true
            return 1
            ;;

        status)
            if tensorboard_is_running; then
                echo "TensorBoard: running"
                echo "Address: http://localhost:${TB_PORT}"
            else
                echo "TensorBoard: not running"
            fi
            ;;

        stop)
            if ! tensorboard_is_running; then
                echo "TensorBoard is not running."
                return 0
            fi

            docker exec "$CONTAINER" bash -lc \
                "pkill -f '[t]ensorboard.main.*--port ${TB_PORT}' || true"

            for _ in {1..10}; do
                if ! tensorboard_is_running; then
                    echo "TensorBoard stopped."
                    return 0
                fi
                sleep 1
            done

            echo "TensorBoard is still responding on port ${TB_PORT}." >&2
            return 1
            ;;

        *)
            echo "Usage: simctl tensorboard {start|status|stop}" >&2
            return 1
            ;;
    esac
}

resolve_train_dir() {
    local RUN_ID
    local LOG
    local TRAIN_DIR
    local HOST_DIR
    local FALLBACK

    RUN_ID="$(current_run)"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    # Preferred path:
    # runs launched through `simctl train` have a launcher log containing
    # the exact RSL-RL training directory.
    if [ -f "$LOG" ]; then
        TRAIN_DIR="$(
            grep -oE '/workspace/IEA_G1/(experiments/g1_stairs/)?logs/rsl_rl/[^[:space:]]+' "$LOG" \
            | head -n 1 || true
        )"

        if [ -n "$TRAIN_DIR" ]; then
            HOST_DIR="$(train_dir_to_host "$TRAIN_DIR")"

            if [ -d "$HOST_DIR" ]; then
                echo "$HOST_DIR"
                return 0
            fi
        fi
    fi

    # Fallback:
    # recorded experiments may be launched directly through
    # run_aws_recorded_experiment.sh and therefore have no simctl launcher
    # log.  Their RSL-RL directory still uses RUN_ID as the final directory
    # name, so resolve it directly from the recorded log tree.
    FALLBACK="$(
        find \
          "${LOG_ROOT}/rsl_rl" \
          -mindepth 2 \
          -maxdepth 2 \
          -type d \
          -name "$RUN_ID" \
          -print \
          2>/dev/null \
          | head -n 1
    )"

    if [ -n "$FALLBACK" ] && [ -d "$FALLBACK" ]; then
        echo "$FALLBACK"
        return 0
    fi

    echo "Could not resolve RSL-RL training directory for run:" >&2
    echo "  $RUN_ID" >&2
    echo >&2
    echo "Checked launcher log:" >&2
    echo "  $LOG" >&2
    echo >&2
    echo "Checked recorded log root:" >&2
    echo "  ${LOG_ROOT}/rsl_rl" >&2
    return 1
}

cmd_showcase() {
    # Presentation video: several robots on scattered stair courses, random
    # start times, moving 1080p camera (record_view.py --showcase). Not an
    # evaluation: no traces, use `simctl video` for single-robot recordings.
    local USAGE="Usage: simctl showcase <checkpoint> [--robots <n>] [--rows <n>] [--seconds <s>] [--height <m>] [--seed <n>] [--no-markers]"
    if [ $# -lt 1 ]; then
        echo "$USAGE"
        exit 1
    fi

    CHECKPOINT="$1"
    shift
    ROBOTS=24
    ROWS=3
    SECONDS_LONG=14
    HEIGHT=0.02
    SEED=1
    MARKERS_OPTION="--markers"

    while [ $# -gt 0 ]; do
        case "$1" in
            --robots|--rows|--seed)
                if [ $# -lt 2 ] || ! [[ "$2" =~ ^[0-9]+$ ]]; then
                    echo "$1 needs a non-negative integer"
                    exit 1
                fi
                case "$1" in
                    --robots) ROBOTS="$2" ;;
                    --rows) ROWS="$2" ;;
                    --seed) SEED="$2" ;;
                esac
                shift 2
                ;;
            --seconds|--height)
                [ $# -ge 2 ] || { echo "$USAGE"; exit 1; }
                if [ "$1" = "--seconds" ]; then SECONDS_LONG="$2"; else HEIGHT="$2"; fi
                shift 2
                ;;
            --no-markers)
                MARKERS_OPTION=""
                shift
                ;;
            *)
                echo "$USAGE"
                exit 1
                ;;
        esac
    done

    if ! [[ "$CHECKPOINT" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint must be an integer, for example: 10200"
        exit 1
    fi
    if [ "$ROBOTS" -lt 1 ] || [ "$ROBOTS" -gt 64 ]; then
        echo "--robots must be 1 to 64"
        exit 1
    fi
    if [ "$ROWS" -lt 1 ] || [ $((ROBOTS % ROWS)) -ne 0 ]; then
        echo "--rows must divide --robots (e.g. 24 robots, 3 rows)"
        exit 1
    fi
    if ! awk -v h="$HEIGHT" 'BEGIN { exit !(h ~ /^([0-9]+([.][0-9]*)?|[.][0-9]+)$/ && h >= 0.0 && h <= 0.20) }'; then
        echo "Height must be a number in [0.0, 0.20] metres"
        exit 1
    fi
    # Policy step is 0.02 s (50 steps per second of video).
    if ! awk -v s="$SECONDS_LONG" 'BEGIN { exit !(s ~ /^([0-9]+([.][0-9]*)?|[.][0-9]+)$/ && s > 0 && s <= 17) }'; then
        echo "--seconds must be in (0, 17] (episodes time out at 18 s)"
        exit 1
    fi
    VIDEO_LENGTH="$(awk -v s="$SECONDS_LONG" 'BEGIN { printf "%d", s * 50 + 0.5 }')"

    RUN_ID="$(current_run)"
    TRAIN_DIR="$(resolve_train_dir)"
    MODEL="${TRAIN_DIR}/model_${CHECKPOINT}.pt"
    if [ ! -f "$MODEL" ]; then
        echo "Checkpoint not found:"
        echo "  $MODEL"
        exit 1
    fi
    RESOLVED_CONFIG="${REPO}/experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"
    if [ ! -f "$RESOLVED_CONFIG" ]; then
        echo "Resolved config not found:"
        echo "  $RESOLVED_CONFIG"
        exit 1
    fi
    TASK="$(python3 -c 'import sys, yaml; print(yaml.safe_load(open(sys.argv[1]))["task"]["id"])' "$RESOLVED_CONFIG")"
    if [ "$TASK" != "Unitree-IEA-G1-29dof-Stairs-Footsteps-v0" ]; then
        echo "Showcase needs the footstep task, this run is: $TASK"
        exit 1
    fi

    ensure_container_running

    HEIGHT_CM="$(awk -v h="$HEIGHT" 'BEGIN { printf "%02d", int(h * 100.0 + 0.5) }')"
    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/videos/${RUN_ID}/showcase_model_${CHECKPOINT}_n${ROBOTS}_r${ROWS}_h${HEIGHT_CM}cm_seed${SEED}"
    CONTAINER_MODEL="${MODEL/$REPO/\/workspace\/IEA_G1}"
    CONTAINER_RESOLVED_CONFIG="${RESOLVED_CONFIG/$REPO/\/workspace\/IEA_G1}"

    echo "========================================"
    echo " G1 SHOWCASE RECORDING"
    echo "========================================"
    echo "Run:        $RUN_ID"
    echo "Checkpoint: model_${CHECKPOINT}.pt"
    echo "Robots:     $ROBOTS in $ROWS rows, height $HEIGHT m, seed $SEED"
    echo "Length:     ${SECONDS_LONG} s (${VIDEO_LENGTH} steps)"
    echo

    docker exec \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      "$CONTAINER" \
      bash -lc "
cd /workspace/IEA_G1

/workspace/isaaclab/isaaclab.sh -p \
  simulation/isaac_lab/g1_stairs/scripts/visualization/record_view.py \
  --task ${TASK} \
  --showcase \
  --showcase_rows ${ROWS} \
  ${MARKERS_OPTION} \
  --num_envs ${ROBOTS} \
  --riser_height_override ${HEIGHT} \
  --view side \
  --output_dir '${OUTPUT_DIR}' \
  --video_length ${VIDEO_LENGTH} \
  --seed ${SEED} \
  --checkpoint '${CONTAINER_MODEL}' \
  --resolved_config '${CONTAINER_RESOLVED_CONFIG}' \
  --project_commit '$(git rev-parse HEAD)' \
  --isaaclab_commit '3c6e67bb5c7ada942a6d1884ab69338f57596f77' \
  --unitree_rl_commit '4960b84732b0c2ec593dccbfe963fda1bcd7b1e3' \
  --unitree_diff_sha256 '54a60bd3ed9de27514530c82936cb43e6b1c5074fee173e81ee271b7ca238b1f' \
  --headless \
  --device cuda:0
"

    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"
    VIDEO_FILE="$(find "$HOST_OUTPUT" -type f -name '*.mp4' -print -quit 2>/dev/null || true)"
    if [ -z "$VIDEO_FILE" ]; then
        echo "ERROR: no video was written to $HOST_OUTPUT" >&2
        exit 1
    fi
    echo
    echo "Video: $VIDEO_FILE"
    echo "Copy to Windows:"
    echo "  scp aws-g1-training:${VIDEO_FILE} \$HOME\\Downloads\\"
}

# Trace batch for checkpoint analysis of the selected run. Without checkpoint
# numbers it takes the run's last checkpoint and the ones nearest 40% and 70%
# of the run. Each checkpoint: flat 3 robots and every stair height of the
# run's training terrain (last checkpoint 10 robots, others 4),
# --trace-only --symmetry check, 600 steps; then trace_report.py and a
# tarball. One replay per checkpoint and height drives all its robots on
# identical courses (record_view.py --num_envs N, seed 1; robot k is written
# as seed k). Single-robot replays were GPU-bound on the A10G (3 in parallel
# 107 s vs 55 s alone), so batching robots is the speed-up, not processes.
cmd_traces() {
    local USAGE="Usage: simctl traces [<checkpoint>...] [--parallel <n>] [--name <tag>] [--symmetry check|average]"
    local CKPTS=() PARALLEL=3 NAME=traces SYM=check
    while [ $# -gt 0 ]; do
        case "$1" in
            --parallel) PARALLEL="${2:?$USAGE}"; shift 2 ;;
            --name) NAME="${2:?$USAGE}"; shift 2 ;;
            --symmetry) SYM="${2:?$USAGE}"; shift 2 ;;
            [0-9]*) CKPTS+=("$1"); shift ;;
            *) echo "$USAGE" >&2; exit 1 ;;
        esac
    done
    [[ "$PARALLEL" =~ ^[1-9]$ ]] || { echo "--parallel must be 1-9" >&2; exit 1; }
    # average: drive with (clip(pi(s)) + M clip(pi(M s)))/2, a diagnostic of a
    # mirror-symmetric residual (record_view.py --symmetry).
    [[ "$SYM" =~ ^(check|average)$ ]] || { echo "--symmetry must be check or average" >&2; exit 1; }
    if [ -f "$CURRENT_PID" ] && kill -0 "$(cat "$CURRENT_PID")" 2>/dev/null; then
        echo "Training is running (PID $(cat "$CURRENT_PID")); replays would slow it down. Wait or run: simctl stop" >&2
        exit 1
    fi
    local RUN_ID TRAIN_DIR CFG EVAL HEIGHTS LAST
    RUN_ID="$(current_run)"; TRAIN_DIR="$(resolve_train_dir)"
    if [ ${#CKPTS[@]} -eq 0 ]; then
        local SAVED
        SAVED="$(find "$TRAIN_DIR" -maxdepth 1 -name 'model_*.pt' | sed -E 's/.*model_([0-9]+)\.pt/\1/' | sort -n)"
        [ -n "$SAVED" ] || { echo "No checkpoints in $TRAIN_DIR" >&2; exit 1; }
        read -r -a CKPTS <<< "$(echo "$SAVED" | awk '{c[NR]=$1} END{
            a=c[1]; b=c[NR];
            for (k=1; k<=2; k++) { t = a + (k==1 ? 0.4 : 0.7) * (b - a); best=c[1];
                for (i=1; i<=NR; i++) if ((c[i]-t)^2 < (best-t)^2) best=c[i]; pick[best]=1 }
            pick[b]=1; for (x in pick) printf "%s ", x }' | tr ' ' '\n' | sort -n | tr '\n' ' ')"
        echo "Checkpoints chosen: ${CKPTS[*]}"
    fi
    CFG="experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"
    EVAL="experiments/g1_stairs/outputs/evaluation/${NAME}/${RUN_ID}"
    [ -f "$CFG" ] || { echo "Resolved config not found: $CFG" >&2; exit 1; }
    for M in "${CKPTS[@]}"; do
        [ -f "${TRAIN_DIR}/model_${M}.pt" ] || { echo "Checkpoint not found: ${TRAIN_DIR}/model_${M}.pt" >&2; exit 1; }
    done
    HEIGHTS="$(python3 -c "import sys,yaml; print(' '.join(str(h) for h in yaml.safe_load(open(sys.argv[1]))['terrain']['riser_heights_m']))" "$CFG")"
    LAST="$(printf '%s\n' "${CKPTS[@]}" | sort -n | tail -n 1)"
    ensure_container_running
    docker exec "$CONTAINER" pkill -9 -f record_view.py >/dev/null 2>&1 || true

    local JOBS="/tmp/simctl_traces_jobs.txt"
    : > "$JOBS"
    for M in "${CKPTS[@]}"; do
        for H in $HEIGHTS; do
            # Last checkpoint: 10 robots on every height (flat drift needs
            # more than 3); robots 1-3 keep the same start as before.
            local ROBOTS=3
            if awk -v h="$H" 'BEGIN{exit !(h > 0)}'; then ROBOTS=4; fi
            [ "$M" = "$LAST" ] && ROBOTS=10
            echo "$M $H $ROBOTS" >> "$JOBS"
        done
    done

    export TR_EVAL="$EVAL" TR_CFG="$CFG" TR_TRAIN="${TRAIN_DIR/$REPO/\/workspace\/IEA_G1}" TR_COMMIT="$(git rev-parse HEAD)" TR_CONTAINER="$CONTAINER" TR_SYM="$SYM"
    trace_one() {
        local M=$1 H=$2 N=$3 HC K DONE=1
        HC="$(awk -v h="$H" 'BEGIN{printf "%02d", int(h * 100 + 0.5)}')"
        local T="${TR_EVAL}/model_${M}_h${HC}cm_seed{env}_side"
        for K in $(seq 1 "$N"); do
            local D="${T/\{env\}/$K}"
            { [ -s "$D/trace.jsonl" ] && [ -s "$D/mirror_check.json" ]; } || DONE=0
        done
        if [ "$DONE" = 1 ]; then echo "SKIP model_${M} ${HC} cm (${N} robots)"; return 0; fi
        for K in $(seq 1 "$N"); do rm -rf "${T/\{env\}/$K}"; done
        mkdir -p "$TR_EVAL"
        # A replay takes 1-3 min; 15 min means it hangs: stop it in the container too.
        timeout 900 docker exec -i --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab --workdir /workspace/IEA_G1 "$TR_CONTAINER" /workspace/isaaclab/isaaclab.sh -p simulation/isaac_lab/g1_stairs/scripts/visualization/record_view.py --task Unitree-IEA-G1-29dof-Stairs-Footsteps-v0 --trace-only --symmetry "$TR_SYM" --view side --output_dir "/workspace/IEA_G1/$T" --video_length 600 --seed 1 --num_envs "$N" --checkpoint "${TR_TRAIN}/model_${M}.pt" --resolved_config "/workspace/IEA_G1/${TR_CFG}" --riser_height_override "$H" --project_commit "$TR_COMMIT" --isaaclab_commit 3c6e67bb5c7ada942a6d1884ab69338f57596f77 --unitree_rl_commit 4960b84732b0c2ec593dccbfe963fda1bcd7b1e3 --unitree_diff_sha256 54a60bd3ed9de27514530c82936cb43e6b1c5074fee173e81ee271b7ca238b1f --headless --device cuda:0 </dev/null > "/tmp/rv_${M}_${HC}.log" 2>&1 \
            || docker exec "$TR_CONTAINER" pkill -9 -f "model_${M}_h${HC}cm_seed" >/dev/null 2>&1 || true
        for K in $(seq 1 "$N"); do
            local D="${T/\{env\}/$K}"
            if ! { [ -s "$D/trace.jsonl" ] && [ -s "$D/mirror_check.json" ]; }; then
                echo "FAIL model_${M} ${HC} cm (log /tmp/rv_${M}_${HC}.log)"; return 0
            fi
        done
        echo "PASS model_${M} ${HC} cm (${N} robots)"
    }
    export -f trace_one

    local START=$SECONDS
    echo "Run $RUN_ID: $(wc -l < "$JOBS") replays, $(awk '{n+=$3} END{print n}' "$JOBS") robots (checkpoints ${CKPTS[*]}; heights ${HEIGHTS} m), ${PARALLEL} at a time -> $EVAL"
    xargs -P "$PARALLEL" -L 1 bash -c 'trace_one "$@"' _ < "$JOBS" | tee /tmp/simctl_traces.log
    echo "Replays done in $(( (SECONDS - START) / 60 )) min $(( (SECONDS - START) % 60 )) s."
    if grep -q "^FAIL" /tmp/simctl_traces.log; then
        echo "Some replays failed (listed above). Run the same command again: finished ones are skipped." >&2
        exit 1
    fi
    python3 simulation/isaac_lab/g1_stairs/scripts/evaluation/trace_report.py "$EVAL" --seeds > "$EVAL/report.txt" || true
    python3 simulation/isaac_lab/g1_stairs/scripts/evaluation/trace_report.py "$EVAL" || true
    local CON TGZ="$HOME/${NAME}_${RUN_ID}.tgz"
    CON="$(find experiments/g1_stairs -path "*${RUN_ID}*" -name console.log | sed -n 1p)"
    tar czf "$TGZ" -C "$EVAL" . ${CON:+-C "$PWD" "$CON"}
    echo
    echo "Tarball: $TGZ"
    echo "Copy:    scp aws-g1-training:${TGZ} \$HOME\\Downloads\\"
}

cmd_video() {
    local VIDEO_USAGE="Usage: simctl video <checkpoint> [--height <m>] [--seed <n>] [--trace-only] [--markers]"
    if [ $# -lt 1 ]; then
        echo "$VIDEO_USAGE"
        exit 1
    fi

    CHECKPOINT="$1"
    shift
    HEIGHT=""
    SEED=42
    SEED_SUFFIX=""
    TRACE_MODE="--trace"
    MARKERS_OPTION=""
    MARKERS_SUFFIX=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --height)
                [ $# -ge 2 ] || { echo "$VIDEO_USAGE"; exit 1; }
                HEIGHT="$2"
                shift 2
                ;;
            --seed)
                if [ $# -lt 2 ] || ! [[ "$2" =~ ^[0-9]+$ ]]; then
                    echo "Seed must be a non-negative integer"
                    exit 1
                fi
                SEED="$2"
                # Seeded runs get their own output folder.
                SEED_SUFFIX="_seed${SEED}"
                shift 2
                ;;
            --trace-only)
                TRACE_MODE="--trace-only"
                shift
                ;;
            --markers)
                # Footstep targets and contact-force bars drawn into the video.
                MARKERS_OPTION="--markers"
                MARKERS_SUFFIX="_markers"
                shift
                ;;
            *)
                echo "$VIDEO_USAGE"
                exit 1
                ;;
        esac
    done

    if [ -n "$HEIGHT" ]; then
        if ! awk -v h="$HEIGHT" 'BEGIN {
            exit !(h ~ /^([0-9]+([.][0-9]*)?|[.][0-9]+)$/ &&
                   h >= 0.0 && h <= 0.20)
        }'; then
            echo "Height must be a number in [0.0, 0.20] metres"
            exit 1
        fi
    fi

    if ! [[ "$CHECKPOINT" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint must be an integer, for example: 800"
        exit 1
    fi

    RUN_ID="$(current_run)"
    TRAIN_DIR="$(resolve_train_dir)"
    MODEL="${TRAIN_DIR}/model_${CHECKPOINT}.pt"

    if [ ! -f "$MODEL" ]; then
        echo "Checkpoint not found:"
        echo "  $MODEL"
        exit 1
    fi

    ensure_container_running

    HEIGHT_SUFFIX=""
    HEIGHT_OPTION=""

    if [ -n "$HEIGHT" ]; then
        HEIGHT_CM="$(awk -v h="$HEIGHT" 'BEGIN {
            printf "%02d", int(h * 100.0 + 0.5)
        }')"
        HEIGHT_SUFFIX="_h${HEIGHT_CM}cm"
        HEIGHT_OPTION="--riser_height_override ${HEIGHT}"
    fi

    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/videos/${RUN_ID}/model_${CHECKPOINT}${HEIGHT_SUFFIX}${SEED_SUFFIX}${MARKERS_SUFFIX}_side"

    PROJECT_COMMIT="$(git rev-parse HEAD)"
    ISAACLAB_COMMIT="3c6e67bb5c7ada942a6d1884ab69338f57596f77"
    UNITREE_RL_COMMIT="4960b84732b0c2ec593dccbfe963fda1bcd7b1e3"
    UNITREE_DIFF_SHA256="54a60bd3ed9de27514530c82936cb43e6b1c5074fee173e81ee271b7ca238b1f"

    CONTAINER_MODEL="${MODEL/$REPO/\/workspace\/IEA_G1}"

    RESOLVED_CONFIG="${REPO}/experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"

    if [ ! -f "$RESOLVED_CONFIG" ]; then
        echo "Resolved config not found:"
        echo "  $RESOLVED_CONFIG"
        exit 1
    fi

    CONTAINER_RESOLVED_CONFIG="${RESOLVED_CONFIG/$REPO/\/workspace\/IEA_G1}"

    VIDEO_TASK="$(python3 - "$RESOLVED_CONFIG" <<'PYTASK'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    config = yaml.safe_load(stream)

task = config.get("task", {}).get("id")
allowed = {
    "Unitree-IEA-G1-29dof-Stairs-v0",
    "Unitree-IEA-G1-29dof-Stairs-Footsteps-v0",
}
if task not in allowed:
    raise SystemExit(f"Unsupported video task: {task!r}")
print(task)
PYTASK
)"

    echo "========================================"
    echo "Task:       $VIDEO_TASK"
    echo " G1 VIDEO RECORDING"
    echo "========================================"
    echo "Run:        $RUN_ID"
    echo "Checkpoint: model_${CHECKPOINT}.pt"
    echo "View:       side"
    echo "Seed:       $SEED"
    echo "Mode:       ${TRACE_MODE#--}"
    if [ -n "$HEIGHT" ]; then
        echo "Height:     $HEIGHT m"
    fi
    echo

    docker exec \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      "$CONTAINER" \
      bash -lc "
cd /workspace/IEA_G1

/workspace/isaaclab/isaaclab.sh -p \
  simulation/isaac_lab/g1_stairs/scripts/visualization/record_view.py \
  --task ${VIDEO_TASK} \
  ${TRACE_MODE} \
  ${MARKERS_OPTION} \
  --view side \
  --output_dir '${OUTPUT_DIR}' \
  --video_length 600 \
  --seed ${SEED} \
  --num_envs 1 \
  --checkpoint '${CONTAINER_MODEL}' \
  --resolved_config '${CONTAINER_RESOLVED_CONFIG}' \
  ${HEIGHT_OPTION} \
  --project_commit '${PROJECT_COMMIT}' \
  --isaaclab_commit '${ISAACLAB_COMMIT}' \
  --unitree_rl_commit '${UNITREE_RL_COMMIT}' \
  --unitree_diff_sha256 '${UNITREE_DIFF_SHA256}' \
  --headless \
  --device cuda:0
"

    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    VIDEO_FILE="$(
        find "$HOST_OUTPUT" -type f -name '*.mp4' -print -quit 2>/dev/null || true
    )"

    if [ "$TRACE_MODE" = "--trace-only" ]; then
        VIDEO_FILE="(trace only, no video)"
        if [ ! -s "${HOST_OUTPUT}/trace.jsonl" ]; then
            echo "ERROR: trace-only run produced no trace:" >&2
            echo "  ${HOST_OUTPUT}/trace.jsonl" >&2
            exit 1
        fi
    elif [ -z "$VIDEO_FILE" ]; then
        echo "ERROR: video command exited without producing an MP4:" >&2
        echo "  $HOST_OUTPUT" >&2
        exit 1
    fi

    METADATA_FILE="${HOST_OUTPUT}/metadata.json"
    if [ ! -f "$METADATA_FILE" ]; then
        echo "ERROR: video metadata is missing:" >&2
        echo "  $METADATA_FILE" >&2
        exit 1
    fi

    python3 - "$METADATA_FILE" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text(encoding="utf-8"))
if data.get("completed") is not True:
    raise SystemExit(f"video metadata is not complete: {path}")
if int(data.get("completed_steps", 0)) <= 0:
    raise SystemExit(f"video metadata has no completed steps: {path}")
PY

    echo
    echo "Video output:"
    echo "  $VIDEO_FILE"
    echo "Trace:"
    echo "  ${HOST_OUTPUT}/trace.jsonl"
}


cmd_baseline() {
    if [ $# -gt 1 ]; then
        echo "Usage: simctl baseline [config.yaml]"
        return 1
    fi

    ensure_container_running

    local CONFIG="${1:-}"
    local STAMP
    local BASELINE_ID
    local OUTPUT_DIR
    local HOST_OUTPUT
    local RUN_DIR=""
    local RESOLVED_CONFIG=""
    local CONTAINER_RESOLVED_CONFIG=""
    local T0_LOG
    local VIDEO_FILE
    local METADATA_FILE

    STAMP="$(date -u +%Y%m%d_%H%M%S)"
    local BASELINE_TASK="Unitree-IEA-G1-29dof-Stairs-v0"
    local -a BASELINE_TRACE=()

    if [ -n "$CONFIG" ]; then
        if [ ! -f "$CONFIG" ]; then
            echo "Config not found: $CONFIG" >&2
            return 1
        fi

        BASELINE_ID="$(basename "$CONFIG" .yaml)_t0_${STAMP}"
        RUN_DIR="${RUN_ROOT}/${BASELINE_ID}"

        python3 \
          simulation/isaac_lab/g1_stairs/scripts/training/prepare_experiment.py \
          "$CONFIG" \
          --output-root "$RUN_ROOT" \
          --run-id "$BASELINE_ID" \
          --allow-blocked

        RESOLVED_CONFIG="${RUN_DIR}/resolved_config.yaml"
        if [ ! -f "$RESOLVED_CONFIG" ]; then
            echo "Resolved config was not created:" >&2
            echo "  $RESOLVED_CONFIG" >&2
            return 1
        fi

        CONTAINER_RESOLVED_CONFIG="${RESOLVED_CONFIG/$REPO/\/workspace\/IEA_G1}"

        # Baseline replays the config's own task (no PPO updates), with trace.
        BASELINE_TASK="$(python3 - "$RESOLVED_CONFIG" <<'PYTASK'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    config = yaml.safe_load(stream)

task = config.get("task", {}).get("id")
allowed = {
    "Unitree-IEA-G1-29dof-Stairs-v0",
    "Unitree-IEA-G1-29dof-Stairs-Footsteps-v0",
    "Unitree-IEA-G1-29dof-Stairs-Flat-Footsteps-v0",
}
if task not in allowed:
    raise SystemExit(f"Unsupported baseline task: {task!r}")
print(task)
PYTASK
)"
        BASELINE_TRACE=(--trace)
    else
        BASELINE_ID="t0_unitree_velocity_prior_${STAMP}"
    fi

    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/baselines/${BASELINE_ID}/side"
    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    mkdir -p "$HOST_OUTPUT"

    if [ -n "$RUN_DIR" ]; then
        T0_LOG="${RUN_DIR}/t0_console.log"
    else
        T0_LOG="${HOST_OUTPUT}/t0_console.log"
    fi

    PROJECT_COMMIT="$(git rev-parse HEAD)"
    ISAACLAB_COMMIT="3c6e67bb5c7ada942a6d1884ab69338f57596f77"
    UNITREE_RL_COMMIT="4960b84732b0c2ec593dccbfe963fda1bcd7b1e3"
    UNITREE_DIFF_SHA256="54a60bd3ed9de27514530c82936cb43e6b1c5074fee173e81ee271b7ca238b1f"

    POLICY_ONNX="/workspace/unitree_rl_lab/deploy/robots/g1_29dof/config/policy/velocity/v0/exported/policy.onnx"

    echo "========================================"
    echo " G1 T0 LOCOMOTION PRIOR BASELINE"
    echo "========================================"
    echo "Baseline:    $BASELINE_ID"
    echo "Task:        $BASELINE_TASK"
    echo "Policy:      Unitree-G1-29dof-Velocity"
    echo "PPO updates: 0"
    echo "Exploration: deterministic inference"
    echo "View:        side"
    if [ -n "$CONFIG" ]; then
        echo "Config:      $CONFIG"
        echo "Resolved:    $RESOLVED_CONFIG"
    fi
    echo "Log:         $T0_LOG"
    echo

    local -a RECORD_CMD=(
        docker exec
        --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab
        --workdir /workspace/IEA_G1
        "$CONTAINER"
        /workspace/isaaclab/isaaclab.sh -p
        simulation/isaac_lab/g1_stairs/scripts/visualization/record_view.py
        --task "$BASELINE_TASK"
        "${BASELINE_TRACE[@]}"
        --view side
        --output_dir "$OUTPUT_DIR"
        --video_length 600
        --seed 42
        --num_envs 1
        --policy_onnx "$POLICY_ONNX"
        --project_commit "$PROJECT_COMMIT"
        --isaaclab_commit "$ISAACLAB_COMMIT"
        --unitree_rl_commit "$UNITREE_RL_COMMIT"
        --unitree_diff_sha256 "$UNITREE_DIFF_SHA256"
        --headless
        --device cuda:0
    )

    if [ -n "$CONTAINER_RESOLVED_CONFIG" ]; then
        RECORD_CMD+=(
            --resolved_config "$CONTAINER_RESOLVED_CONFIG"
        )
    fi

    "${RECORD_CMD[@]}" 2>&1 | tee "$T0_LOG"

    VIDEO_FILE="$(
        find "$HOST_OUTPUT" -type f -name '*.mp4' -print -quit 2>/dev/null || true
    )"

    if [ -z "$VIDEO_FILE" ]; then
        echo "ERROR: baseline completed without producing an MP4:" >&2
        echo "  $HOST_OUTPUT" >&2
        return 1
    fi

    METADATA_FILE="${HOST_OUTPUT}/metadata.json"
    if [ ! -f "$METADATA_FILE" ]; then
        echo "ERROR: baseline metadata is missing:" >&2
        echo "  $METADATA_FILE" >&2
        return 1
    fi

    python3 - "$METADATA_FILE" "$RESOLVED_CONFIG" <<'PY'
import json
import sys
from pathlib import Path

metadata_path = Path(sys.argv[1])
resolved_value = sys.argv[2]
metadata = json.loads(metadata_path.read_text(encoding="utf-8"))

if metadata.get("completed") is not True:
    raise SystemExit(f"baseline metadata is not complete: {metadata_path}")
if int(metadata.get("completed_steps", 0)) <= 0:
    raise SystemExit(f"baseline metadata has no completed steps: {metadata_path}")

initialization = metadata.get("policy_initialization") or {}
if initialization.get("new_columns_max_abs") != 0.0:
    raise SystemExit(
        "baseline policy transfer did not zero new observation columns: "
        f"{initialization.get('new_columns_max_abs')}"
    )

if resolved_value:
    import yaml

    resolved_path = Path(resolved_value)
    resolved = yaml.safe_load(resolved_path.read_text(encoding="utf-8"))
    expected = resolved.get("policy_initialization", {})

    for key in (
        "locomotion_observations",
        "actor_height_scan_observations",
        "explicit_geometry_observations",
        "stair_observations",
        "actions",
    ):
        if key not in expected:
            continue
        if initialization.get(key) != expected[key]:
            raise SystemExit(
                f"baseline policy contract mismatch for {key}: "
                f"expected {expected[key]!r}, "
                f"got {initialization.get(key)!r}"
            )
PY

    echo
    echo "Baseline output:"
    echo "  $HOST_OUTPUT"
    echo "Video:"
    echo "  $VIDEO_FILE"
    echo "Metadata:"
    echo "  $METADATA_FILE"
    echo "Log:"
    echo "  $T0_LOG"
}

cmd_evaluate() {
    if [ $# -ne 1 ]; then
        echo "Usage: simctl evaluate <checkpoint>"
        exit 1
    fi

    CHECKPOINT="$1"

    if ! [[ "$CHECKPOINT" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint must be an integer, for example: 1999"
        exit 1
    fi

    RUN_ID="$(current_run)"
    TRAIN_DIR="$(resolve_train_dir)"
    MODEL="${TRAIN_DIR}/model_${CHECKPOINT}.pt"

    if [ ! -f "$MODEL" ]; then
        echo "Checkpoint not found:"
        echo "  $MODEL"
        exit 1
    fi

    ensure_container_running

    CONTAINER_MODEL="${MODEL/$REPO/\/workspace\/IEA_G1}"
    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/evaluation/${RUN_ID}/model_${CHECKPOINT}_seed42"

    RESOLVED_CONFIG="${REPO}/experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"

    if [ ! -f "$RESOLVED_CONFIG" ]; then
        echo "Resolved config not found:"
        echo "  $RESOLVED_CONFIG"
        exit 1
    fi

    CONTAINER_RESOLVED_CONFIG="${RESOLVED_CONFIG/$REPO/\/workspace\/IEA_G1}"

    echo "========================================"
    echo " G1 CHECKPOINT EVALUATION"
    echo "========================================"
    echo "Run:        $RUN_ID"
    echo "Checkpoint: model_${CHECKPOINT}.pt"
    echo "Seed:       42"
    echo "Max steps:  900"
    echo

    docker exec \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      "$CONTAINER" \
      bash -lc "
cd /workspace/IEA_G1

/workspace/isaaclab/isaaclab.sh -p \
  simulation/isaac_lab/g1_stairs/scripts/evaluation/evaluate_isaac_stairs.py \
  --task Unitree-IEA-G1-29dof-Stairs-v0 \
  --checkpoint '${CONTAINER_MODEL}' \
  --resolved-config '${CONTAINER_RESOLVED_CONFIG}' \
  --output-dir '${OUTPUT_DIR}' \
  --max-steps 900 \
  --seed 42 \
  --headless \
  --device cuda:0
"

    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    echo
    echo "Evaluation output:"
    if [ -d "$HOST_OUTPUT" ]; then
        find "$HOST_OUTPUT" -maxdepth 2 -type f -printf '%p\n' | sort
    else
        echo "  Output directory was not created."
    fi
}

cmd_info() {
    RUN_ID="$(current_run)"

    echo "Current run:"
    echo "  $RUN_ID"
    echo
    echo "Run directory:"
    echo "  ${RUN_ROOT}/${RUN_ID}"
    echo
    echo "Launcher log:"
    echo "  ${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"
    echo
    echo "Project commit:"
    git rev-parse HEAD
    echo
    echo "Git status:"
    if [ -z "$(git status --porcelain)" ]; then
        echo "  clean"
    else
        git status --short
    fi
}

case "${1:-help}" in
    train)
        shift
        cmd_train "$@"
        ;;
    stop)
        cmd_stop
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    diagnose)
        cmd_diagnose
        ;;
    mechanics)
        cmd_mechanics
        ;;
    health)
        shift
        cmd_health "$@"
        ;;
    runs)
        cmd_runs
        ;;
    use)
        shift
        cmd_use "$@"
        ;;
    tensorboard)
        shift
        cmd_tensorboard "$@"
        ;;
    video)
        shift
        cmd_video "$@"
        ;;
    traces)
        shift
        cmd_traces "$@"
        ;;
    showcase)
        shift
        cmd_showcase "$@"
        ;;
    baseline)
        shift
        cmd_baseline "$@"
        ;;
    evaluate)
        shift
        cmd_evaluate "$@"
        ;;
    info)
        cmd_info
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        echo
        usage
        exit 1
        ;;
esac
