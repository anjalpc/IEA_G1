#!/usr/bin/env bash
set -euo pipefail

REPO="/home/ubuntu/workspace/IEA_G1"
WORKSPACE="/home/ubuntu/workspace"

EXPERIMENT_ROOT="${REPO}/experiments/g1_stairs"
RUN_ROOT="${EXPERIMENT_ROOT}/runs"
LOG_ROOT="${EXPERIMENT_ROOT}/logs"
OUTPUT_ROOT="${EXPERIMENT_ROOT}/outputs"
STATE_DIR="${WORKSPACE}/state/IEA_G1"
LAUNCHER_LOG_DIR="${STATE_DIR}/launcher_logs"
CURRENT_RUN="${STATE_DIR}/current_run"
CURRENT_PID="${STATE_DIR}/current_pid"
TRAIN_WRAPPER="${REPO}/simulation/isaac_lab/g1_stairs/scripts/training/run_aws_recorded_experiment.sh"
TB_PORT=6006
CONTAINER="isaac-lab-fixed"

ensure_state_dirs() {
    mkdir -p "$STATE_DIR" "$LAUNCHER_LOG_DIR"
}

cd "$REPO"

usage() {
    cat <<USAGE
Usage:
  simctl train <config.yaml>
  simctl stop
  simctl status
  simctl diagnose
  simctl mechanics
  simctl health [--json]
  simctl info
  simctl runs
  simctl use <run_id>
  simctl tensorboard {start|status|stop}
  simctl video <checkpoint>
  simctl baseline [config.yaml]
  simctl evaluate <checkpoint>
  simctl help
USAGE
}

ensure_container_running() {
    if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
        echo "Required container does not exist: $CONTAINER" >&2
        echo "Refusing to recreate it automatically." >&2
        exit 1
    fi

    RUNNING="$(
        docker inspect \
          --format '{{.State.Running}}' \
          "$CONTAINER"
    )"

    if [ "$RUNNING" != "true" ]; then
        echo "Starting container: $CONTAINER"

        docker start "$CONTAINER" >/dev/null

        for _ in {1..10}; do
            RUNNING="$(
                docker inspect \
                  --format '{{.State.Running}}' \
                  "$CONTAINER"
            )"

            if [ "$RUNNING" = "true" ]; then
                echo "Container running."
                return 0
            fi

            sleep 1
        done

        echo "Container failed to start: $CONTAINER" >&2
        exit 1
    fi
}

current_run() {
    if [ ! -f "$CURRENT_RUN" ]; then
        echo "No current training run recorded." >&2
        exit 1
    fi
    cat "$CURRENT_RUN"
}

train_dir_to_host() {
    local train_dir="$1"

    case "$train_dir" in
        /workspace/IEA_G1/experiments/g1_stairs/logs/*)
            echo "${train_dir/\/workspace\/IEA_G1/$REPO}"
            ;;
        /workspace/IEA_G1/logs/*)
            local relative="${train_dir#/workspace/IEA_G1/logs/}"
            echo "${LOG_ROOT}/${relative}"
            ;;
        *)
            echo "Unsupported training directory: $train_dir" >&2
            return 1
            ;;
    esac
}

cmd_runs() {
    echo "========================================"
    echo " AVAILABLE RECORDED RUNS"
    echo "========================================"

    CURRENT=""
    if [ -f "$CURRENT_RUN" ]; then
        CURRENT="$(cat "$CURRENT_RUN")"
    fi

    found=0

    for dir in "$RUN_ROOT"/*; do
        [ -d "$dir" ] || continue

        run_id="$(basename "$dir")"
        manifest="$dir/run_manifest.yaml"

        if [ -f "$manifest" ]; then
            status="$(
                grep -E '^  status:' "$manifest" \
                | tail -n 1 \
                | sed 's/^  status:[[:space:]]*//' \
                || true
            )"
        else
            status="unknown"
        fi

        marker=" "
        if [ "$run_id" = "$CURRENT" ]; then
            marker="*"
        fi

        printf "%s %-55s %s\n" "$marker" "$run_id" "${status:-unknown}"
        found=1
    done

    if [ "$found" -eq 0 ]; then
        echo "No recorded runs found."
    fi

    echo
    echo "* = currently selected run"
}

cmd_use() {
    if [ $# -ne 1 ]; then
        echo "Usage: simctl use <run_id>"
        exit 1
    fi

    RUN_ID="$1"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"

    if [ ! -d "$RUN_DIR" ]; then
        echo "Run not found:"
        echo "  $RUN_DIR"
        echo
        echo "Use 'simctl runs' to list available runs."
        exit 1
    fi

    ensure_state_dirs
    printf '%s\n' "$RUN_ID" > "$CURRENT_RUN"

    echo "Selected run:"
    echo "  $RUN_ID"
    echo
    echo "Commands such as status, video and evaluate now use this run."
}

cmd_train() {
    if [ $# -lt 1 ]; then
        echo "Missing experiment config."
        usage
        exit 1
    fi

    CONFIG="$1"

    if [ ! -f "$CONFIG" ]; then
        echo "Config not found: $CONFIG"
        exit 1
    fi

    if [ -n "$(git status --porcelain)" ]; then
        echo "Refusing to train from a dirty worktree."
        git status --short
        exit 1
    fi

    ensure_container_running

    BASE="$(basename "$CONFIG" .yaml)"
    RUN_ID="${BASE}_$(date -u +%Y%m%d_%H%M%S)"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    ensure_state_dirs
    printf '%s\n' "$RUN_ID" > "$CURRENT_RUN"

    echo "========================================"
    echo " G1 STAIR TRAINING"
    echo "========================================"
    echo "Config: $CONFIG"
    echo "Run:    $RUN_ID"
    echo "Log:    $LOG"
    echo

    nohup "$TRAIN_WRAPPER" \
        "$CONFIG" \
        --run-id "$RUN_ID" \
        > "$LOG" 2>&1 &

    PID=$!

    echo "$PID" > "$CURRENT_PID"

    echo "Started."
    echo "PID: $PID"
    echo
    echo "Use:"
    echo "  simulation/isaac_lab/g1_stairs/scripts/simctl status"
}

cmd_stop() {
    ensure_state_dirs

    local RUN_ID=""
    local LAUNCHER_PID=""
    local TRAIN_PIDS=""
    local LEFT=""

    if [ -f "$CURRENT_RUN" ]; then
        RUN_ID="$(cat "$CURRENT_RUN")"
    fi

    if [ -f "$CURRENT_PID" ]; then
        LAUNCHER_PID="$(cat "$CURRENT_PID")"
    fi

    echo "========================================"
    echo " STOP G1 STAIR TRAINING"
    echo "========================================"

    if [ -n "$RUN_ID" ]; then
        echo "Run: $RUN_ID"
    else
        echo "Run: not recorded"
    fi

    # Stop the actual Isaac/RSL-RL process inside the persistent container.
    # The PID stored by simctl belongs to the host-side launcher wrapper, not
    # necessarily the final Python training process.
    if docker inspect "$CONTAINER" >/dev/null 2>&1; then
        if [ "$(
            docker inspect \
              --format '{{.State.Running}}' \
              "$CONTAINER"
        )" = "true" ]; then

            TRAIN_PIDS="$(
                docker exec "$CONTAINER" bash -lc '
                    ps -eo pid,args \
                    | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
                ' || true
            )"

            if [ -n "$TRAIN_PIDS" ]; then
                echo "Training PID(s) in container: $TRAIN_PIDS"
                echo "Sending SIGTERM..."

                docker exec "$CONTAINER" bash -lc "
                    kill -TERM $TRAIN_PIDS
                "

                for _ in {1..10}; do
                    sleep 1

                    LEFT="$(
                        docker exec "$CONTAINER" bash -lc '
                            ps -eo pid,args \
                            | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
                        ' || true
                    )"

                    if [ -z "$LEFT" ]; then
                        break
                    fi
                done

                if [ -n "$LEFT" ]; then
                    echo "Still running after SIGTERM: $LEFT"
                    echo "Sending SIGKILL..."

                    docker exec "$CONTAINER" bash -lc "
                        kill -KILL $LEFT
                    "
                fi
            else
                echo "No active run_isaac_stairs.py train process found."
            fi
        else
            echo "Container is not running."
        fi
    else
        echo "Container does not exist: $CONTAINER"
    fi

    # Also stop the host launcher wrapper if it survived after the child
    # training process exited.
    if [ -n "$LAUNCHER_PID" ] \
       && [[ "$LAUNCHER_PID" =~ ^[0-9]+$ ]] \
       && kill -0 "$LAUNCHER_PID" 2>/dev/null; then

        echo "Stopping launcher PID: $LAUNCHER_PID"
        kill -TERM "$LAUNCHER_PID" 2>/dev/null || true

        for _ in {1..5}; do
            if ! kill -0 "$LAUNCHER_PID" 2>/dev/null; then
                break
            fi
            sleep 1
        done

        if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
            echo "Launcher still alive; sending SIGKILL."
            kill -KILL "$LAUNCHER_PID" 2>/dev/null || true
        fi
    fi

    rm -f "$CURRENT_PID"

    LEFT=""

    if docker inspect "$CONTAINER" >/dev/null 2>&1 \
       && [ "$(
           docker inspect \
             --format '{{.State.Running}}' \
             "$CONTAINER"
       )" = "true" ]; then

        LEFT="$(
            docker exec "$CONTAINER" bash -lc '
                ps -eo pid,args \
                | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
            ' || true
        )"
    fi

    if [ -n "$LEFT" ]; then
        echo "ERROR: training process is still running: $LEFT" >&2
        return 1
    fi

    echo "Training stopped."
}

cmd_diagnose() {
    local RUN_ID
    local RUN_DIR
    local CONTAINER_RUN_DIR
    local REPORT_SCRIPT

    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"

    CONTAINER_RUN_DIR="/workspace/IEA_G1/experiments/g1_stairs/runs/${RUN_ID}"
    REPORT_SCRIPT="/workspace/IEA_G1/simulation/isaac_lab/g1_stairs/scripts/diagnostics/build_run_diagnostic_report.py"

    echo "========================================"
    echo " G1 STAIR DIAGNOSTICS"
    echo "========================================"
    echo "Run: $RUN_ID"
    echo

    if [ ! -d "$RUN_DIR" ]; then
        echo "Run directory not found:" >&2
        echo "  $RUN_DIR" >&2
        return 1
    fi

    ensure_container_running

    if ! docker exec \
        "$CONTAINER" \
        test -f "$REPORT_SCRIPT"
    then
        echo "Diagnostic report script not found in container:" >&2
        echo "  $REPORT_SCRIPT" >&2
        return 1
    fi

    docker exec \
        --workdir /workspace/IEA_G1 \
        "$CONTAINER" \
        /workspace/isaaclab/_isaac_sim/python.sh \
        "$REPORT_SCRIPT" \
        "$CONTAINER_RUN_DIR"

    if [ ! -f "$RUN_DIR/diagnostic_summary.json" ]; then
        echo "Diagnostic summary was not generated:" >&2
        echo "  $RUN_DIR/diagnostic_summary.json" >&2
        return 1
    fi

    if [ ! -f "$RUN_DIR/diagnostic_report.md" ]; then
        echo "Diagnostic report was not generated:" >&2
        echo "  $RUN_DIR/diagnostic_report.md" >&2
        return 1
    fi

    echo
    echo "========================================"
    echo " DIAGNOSTIC REPORT"
    echo "========================================"
    echo

    cat "$RUN_DIR/diagnostic_report.md"

    echo
    echo "========================================"
    echo " OUTPUTS"
    echo "========================================"
    echo "$RUN_DIR/diagnostic_summary.json"
    echo "$RUN_DIR/diagnostic_report.md"
}


cmd_mechanics() {
    local RUN_ID
    local RUN_DIR
    local RESOLVED
    local OUTPUT_DIR
    local CONTAINER_RESOLVED
    local CONTAINER_OUTPUT
    local SCRIPT
    local ACTIVE

    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"
    RESOLVED="${RUN_DIR}/resolved_config.yaml"
    OUTPUT_DIR="${RUN_DIR}/mechanics_qualification"
    CONTAINER_RESOLVED="/workspace/IEA_G1/experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"
    CONTAINER_OUTPUT="/workspace/IEA_G1/experiments/g1_stairs/runs/${RUN_ID}/mechanics_qualification"
    SCRIPT="/workspace/IEA_G1/simulation/isaac_lab/g1_stairs/scripts/diagnostics/qualify_single_support.py"

    if [ ! -f "$RESOLVED" ]; then
        echo "Resolved config not found:" >&2
        echo "  $RESOLVED" >&2
        return 1
    fi

    ensure_container_running

    ACTIVE="$(
        docker exec "$CONTAINER" bash -lc '
            ps -eo pid,args \
            | awk "/run_isaac_stairs.py train/ && !/awk/ {print \$1}"
        ' || true
    )"

    if [ -n "$ACTIVE" ]; then
        echo "Refusing mechanics qualification while training is active:" >&2
        echo "  PID(s): $ACTIVE" >&2
        echo "Stop the run first with: simctl stop" >&2
        return 1
    fi

    rm -rf "$OUTPUT_DIR"

    echo "========================================"
    echo " G1 SINGLE-SUPPORT MECHANICS"
    echo "========================================"
    echo "Run: $RUN_ID"
    echo "Policy: NONE"
    echo "Rewards: DISABLED"
    echo

    docker exec \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      --env UNITREE_MODEL_ROOT=/workspace/unitree_model \
      --workdir /workspace/IEA_G1 \
      "$CONTAINER" \
      /workspace/isaaclab/isaaclab.sh -p \
      "$SCRIPT" \
      --task Unitree-IEA-G1-29dof-Stairs-v0 \
      --resolved-config "$CONTAINER_RESOLVED" \
      --output-dir "$CONTAINER_OUTPUT" \
      --seed 42 \
      --headless \
      --device cuda:0

    if [ ! -f "$OUTPUT_DIR/mechanics_report.txt" ]; then
        echo "Mechanics report was not generated:" >&2
        echo "  $OUTPUT_DIR/mechanics_report.txt" >&2
        return 1
    fi

    echo
    cat "$OUTPUT_DIR/mechanics_report.txt"
}


cmd_health() {
    local RUN_ID
    local RUN_DIR
    local HEALTH_SCRIPT

    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"
    HEALTH_SCRIPT="${REPO}/simulation/isaac_lab/g1_stairs/scripts/diagnostics/reward_health.py"

    if [ ! -d "$RUN_DIR" ]; then
        echo "Run directory not found:" >&2
        echo "  $RUN_DIR" >&2
        return 1
    fi

    if [ ! -f "$HEALTH_SCRIPT" ]; then
        echo "Health script not found:" >&2
        echo "  $HEALTH_SCRIPT" >&2
        return 1
    fi

    # Host-side only: reading the append-only CSV evidence must never touch
    # or pause the active Isaac/RSL-RL process.
    python3 "$HEALTH_SCRIPT" "$RUN_DIR" "$@"
}

cmd_status() {
    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"
    MANIFEST="${RUN_DIR}/run_manifest.yaml"
    METRICS="${RUN_DIR}/training_metrics.csv"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    echo "========================================"
    echo " G1 TRAINING STATUS"
    echo "========================================"
    echo "Run: $RUN_ID"

    if [ -f "$MANIFEST" ]; then
        STATUS="$(grep -E '^  status:' "$MANIFEST" | tail -n 1 | sed 's/^  status:[[:space:]]*//')"
        EXIT_CODE="$(grep -E '^  exit_code:' "$MANIFEST" | tail -n 1 | sed 's/^  exit_code:[[:space:]]*//' || true)"
        echo "Status: ${STATUS:-unknown}"
        [ -n "${EXIT_CODE:-}" ] && echo "Exit code: $EXIT_CODE"
    else
        echo "Status: starting"
    fi

    if [ -f "$METRICS" ]; then
        python3 - "$METRICS" <<'STATUS_PY'
import csv
import math
import sys

with open(sys.argv[1], newline="") as stream:
    rows = list(csv.DictReader(stream))

print()
print("TRAINING / EXECUTION")

if rows:
    row = rows[-1]
    print("  Latest iteration:", row.get("iteration") or "NOT RECORDED")
    print("  Recorded metric rows:", len(rows))

    try:
        reward = float(row.get("episode_return_mean", ""))
        if math.isfinite(reward):
            print(f"  PPO mean return: {reward:.4f} (learning signal only)")
        else:
            print("  PPO mean return: NOT RECORDED")
    except (ValueError, TypeError):
        print("  PPO mean return: NOT RECORDED")
else:
    print("  Training metrics: NOT RECORDED")

print()
print("PLANNED-FOOTSTEP EVALUATION")
print("  Status: NOT MEASURED")
print("  No validated planned_footsteps_v1 report integration.")
print("  Legacy success and progression counters excluded.")
STATUS_PY
    fi

    echo
    echo "Latest checkpoint:"

    TRAIN_DIR="$(resolve_train_dir 2>/dev/null || true)"

    if [ -n "$TRAIN_DIR" ] && [ -d "$TRAIN_DIR" ]; then
        LATEST_CHECKPOINT="$(
            find "$TRAIN_DIR" -maxdepth 1 -type f -name 'model_*.pt' \
                2>/dev/null \
                | sed -E 's/.*model_([0-9]+)\.pt/\1 &/' \
                | sort -n \
                | tail -n 1 \
                | cut -d' ' -f2- || true
        )"

        if [ -n "$LATEST_CHECKPOINT" ]; then
            echo "$LATEST_CHECKPOINT"
        else
            echo "No checkpoint found yet."
        fi
    else
        echo "Not resolved yet."
    fi

    echo
    if curl -fsS --max-time 1 "http://127.0.0.1:${TB_PORT}/" >/dev/null 2>&1; then
        echo "TensorBoard: running at http://localhost:${TB_PORT}"
    else
        echo "TensorBoard: not running"
        echo "Start with: simctl tensorboard start"
    fi
    echo "========================================"
}

tensorboard_is_running() {
    curl -fsS --max-time 1 \
        "http://127.0.0.1:${TB_PORT}/" \
        >/dev/null 2>&1
}

cmd_tensorboard() {
    local action="${1:-status}"

    case "$action" in
        start)
            ensure_container_running

            if tensorboard_is_running; then
                echo "TensorBoard already running."
                echo "Open: http://localhost:${TB_PORT}"
                return 0
            fi

            echo "Starting TensorBoard..."

            docker exec -d \
                "$CONTAINER" \
                bash -lc "
                exec /workspace/isaaclab/isaaclab.sh -p -m tensorboard.main \
                  --logdir /workspace/IEA_G1/experiments/g1_stairs/logs/rsl_rl \
                  --host 127.0.0.1 \
                  --port ${TB_PORT} \
                  > /tmp/tensorboard.log 2>&1
                "

            for _ in {1..10}; do
                if tensorboard_is_running; then
                    echo "TensorBoard started."
                    echo "Open: http://localhost:${TB_PORT}"
                    return 0
                fi
                sleep 1
            done

            echo "TensorBoard failed to start." >&2
            echo "Container log:" >&2
            docker exec "$CONTAINER" \
                tail -n 40 /tmp/tensorboard.log 2>/dev/null || true
            return 1
            ;;

        status)
            if tensorboard_is_running; then
                echo "TensorBoard: running"
                echo "Address: http://localhost:${TB_PORT}"
            else
                echo "TensorBoard: not running"
            fi
            ;;

        stop)
            if ! tensorboard_is_running; then
                echo "TensorBoard is not running."
                return 0
            fi

            docker exec "$CONTAINER" bash -lc \
                "pkill -f '[t]ensorboard.main.*--port ${TB_PORT}' || true"

            for _ in {1..10}; do
                if ! tensorboard_is_running; then
                    echo "TensorBoard stopped."
                    return 0
                fi
                sleep 1
            done

            echo "TensorBoard is still responding on port ${TB_PORT}." >&2
            return 1
            ;;

        *)
            echo "Usage: simctl tensorboard {start|status|stop}" >&2
            return 1
            ;;
    esac
}

resolve_train_dir() {
    local RUN_ID
    local LOG
    local TRAIN_DIR
    local HOST_DIR
    local FALLBACK

    RUN_ID="$(current_run)"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    # Preferred path:
    # runs launched through `simctl train` have a launcher log containing
    # the exact RSL-RL training directory.
    if [ -f "$LOG" ]; then
        TRAIN_DIR="$(
            grep -oE '/workspace/IEA_G1/(experiments/g1_stairs/)?logs/rsl_rl/[^[:space:]]+' "$LOG" \
            | head -n 1 || true
        )"

        if [ -n "$TRAIN_DIR" ]; then
            HOST_DIR="$(train_dir_to_host "$TRAIN_DIR")"

            if [ -d "$HOST_DIR" ]; then
                echo "$HOST_DIR"
                return 0
            fi
        fi
    fi

    # Fallback:
    # recorded experiments may be launched directly through
    # run_aws_recorded_experiment.sh and therefore have no simctl launcher
    # log.  Their RSL-RL directory still uses RUN_ID as the final directory
    # name, so resolve it directly from the recorded log tree.
    FALLBACK="$(
        find \
          "${LOG_ROOT}/rsl_rl" \
          -mindepth 2 \
          -maxdepth 2 \
          -type d \
          -name "$RUN_ID" \
          -print \
          2>/dev/null \
          | head -n 1
    )"

    if [ -n "$FALLBACK" ] && [ -d "$FALLBACK" ]; then
        echo "$FALLBACK"
        return 0
    fi

    echo "Could not resolve RSL-RL training directory for run:" >&2
    echo "  $RUN_ID" >&2
    echo >&2
    echo "Checked launcher log:" >&2
    echo "  $LOG" >&2
    echo >&2
    echo "Checked recorded log root:" >&2
    echo "  ${LOG_ROOT}/rsl_rl" >&2
    return 1
}

cmd_video() {
    if [ $# -ne 1 ] && [ $# -ne 3 ]; then
        echo "Usage: simctl video <checkpoint> [--height <m>]"
        exit 1
    fi

    CHECKPOINT="$1"
    HEIGHT=""

    if [ $# -eq 3 ]; then
        if [ "$2" != "--height" ]; then
            echo "Usage: simctl video <checkpoint> [--height <m>]"
            exit 1
        fi

        HEIGHT="$3"

        if ! awk -v h="$HEIGHT" 'BEGIN {
            exit !(h ~ /^([0-9]+([.][0-9]*)?|[.][0-9]+)$/ &&
                   h >= 0.0 && h <= 0.20)
        }'; then
            echo "Height must be a number in [0.0, 0.20] metres"
            exit 1
        fi
    fi

    if ! [[ "$CHECKPOINT" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint must be an integer, for example: 800"
        exit 1
    fi

    RUN_ID="$(current_run)"
    TRAIN_DIR="$(resolve_train_dir)"
    MODEL="${TRAIN_DIR}/model_${CHECKPOINT}.pt"

    if [ ! -f "$MODEL" ]; then
        echo "Checkpoint not found:"
        echo "  $MODEL"
        exit 1
    fi

    ensure_container_running

    HEIGHT_SUFFIX=""
    HEIGHT_OPTION=""

    if [ -n "$HEIGHT" ]; then
        HEIGHT_CM="$(awk -v h="$HEIGHT" 'BEGIN {
            printf "%02d", int(h * 100.0 + 0.5)
        }')"
        HEIGHT_SUFFIX="_h${HEIGHT_CM}cm"
        HEIGHT_OPTION="--riser_height_override ${HEIGHT}"
    fi

    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/videos/${RUN_ID}/model_${CHECKPOINT}${HEIGHT_SUFFIX}_side"

    PROJECT_COMMIT="$(git rev-parse HEAD)"
    ISAACLAB_COMMIT="3c6e67bb5c7ada942a6d1884ab69338f57596f77"
    UNITREE_RL_COMMIT="4960b84732b0c2ec593dccbfe963fda1bcd7b1e3"
    UNITREE_DIFF_SHA256="54a60bd3ed9de27514530c82936cb43e6b1c5074fee173e81ee271b7ca238b1f"

    CONTAINER_MODEL="${MODEL/$REPO/\/workspace\/IEA_G1}"

    RESOLVED_CONFIG="${REPO}/experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"

    if [ ! -f "$RESOLVED_CONFIG" ]; then
        echo "Resolved config not found:"
        echo "  $RESOLVED_CONFIG"
        exit 1
    fi

    CONTAINER_RESOLVED_CONFIG="${RESOLVED_CONFIG/$REPO/\/workspace\/IEA_G1}"

    VIDEO_TASK="$(python3 - "$RESOLVED_CONFIG" <<'PYTASK'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    config = yaml.safe_load(stream)

task = config.get("task", {}).get("id")
allowed = {
    "Unitree-IEA-G1-29dof-Stairs-v0",
    "Unitree-IEA-G1-29dof-Stairs-Footsteps-v0",
}
if task not in allowed:
    raise SystemExit(f"Unsupported video task: {task!r}")
print(task)
PYTASK
)"

    echo "========================================"
    echo "Task:       $VIDEO_TASK"
    echo " G1 VIDEO RECORDING"
    echo "========================================"
    echo "Run:        $RUN_ID"
    echo "Checkpoint: model_${CHECKPOINT}.pt"
    echo "View:       side"
    if [ -n "$HEIGHT" ]; then
        echo "Height:     $HEIGHT m"
    fi
    echo

    docker exec \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      "$CONTAINER" \
      bash -lc "
cd /workspace/IEA_G1

/workspace/isaaclab/isaaclab.sh -p \
  simulation/isaac_lab/g1_stairs/scripts/visualization/record_view.py \
  --task ${VIDEO_TASK} \
  --trace \
  --view side \
  --output_dir '${OUTPUT_DIR}' \
  --video_length 600 \
  --seed 42 \
  --num_envs 1 \
  --checkpoint '${CONTAINER_MODEL}' \
  --resolved_config '${CONTAINER_RESOLVED_CONFIG}' \
  ${HEIGHT_OPTION} \
  --project_commit '${PROJECT_COMMIT}' \
  --isaaclab_commit '${ISAACLAB_COMMIT}' \
  --unitree_rl_commit '${UNITREE_RL_COMMIT}' \
  --unitree_diff_sha256 '${UNITREE_DIFF_SHA256}' \
  --headless \
  --device cuda:0
"

    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    VIDEO_FILE="$(
        find "$HOST_OUTPUT" -type f -name '*.mp4' -print -quit 2>/dev/null || true
    )"

    if [ -z "$VIDEO_FILE" ]; then
        echo "ERROR: video command exited without producing an MP4:" >&2
        echo "  $HOST_OUTPUT" >&2
        exit 1
    fi

    METADATA_FILE="${HOST_OUTPUT}/metadata.json"
    if [ ! -f "$METADATA_FILE" ]; then
        echo "ERROR: video metadata is missing:" >&2
        echo "  $METADATA_FILE" >&2
        exit 1
    fi

    python3 - "$METADATA_FILE" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text(encoding="utf-8"))
if data.get("completed") is not True:
    raise SystemExit(f"video metadata is not complete: {path}")
if int(data.get("completed_steps", 0)) <= 0:
    raise SystemExit(f"video metadata has no completed steps: {path}")
PY

    echo
    echo "Video output:"
    echo "  $VIDEO_FILE"
}


cmd_baseline() {
    if [ $# -gt 1 ]; then
        echo "Usage: simctl baseline [config.yaml]"
        return 1
    fi

    ensure_container_running

    local CONFIG="${1:-}"
    local STAMP
    local BASELINE_ID
    local OUTPUT_DIR
    local HOST_OUTPUT
    local RUN_DIR=""
    local RESOLVED_CONFIG=""
    local CONTAINER_RESOLVED_CONFIG=""
    local T0_LOG
    local VIDEO_FILE
    local METADATA_FILE

    STAMP="$(date -u +%Y%m%d_%H%M%S)"
    local BASELINE_TASK="Unitree-IEA-G1-29dof-Stairs-v0"
    local -a BASELINE_TRACE=()

    if [ -n "$CONFIG" ]; then
        if [ ! -f "$CONFIG" ]; then
            echo "Config not found: $CONFIG" >&2
            return 1
        fi

        BASELINE_ID="$(basename "$CONFIG" .yaml)_t0_${STAMP}"
        RUN_DIR="${RUN_ROOT}/${BASELINE_ID}"

        python3 \
          simulation/isaac_lab/g1_stairs/scripts/training/prepare_experiment.py \
          "$CONFIG" \
          --output-root "$RUN_ROOT" \
          --run-id "$BASELINE_ID" \
          --allow-blocked

        RESOLVED_CONFIG="${RUN_DIR}/resolved_config.yaml"
        if [ ! -f "$RESOLVED_CONFIG" ]; then
            echo "Resolved config was not created:" >&2
            echo "  $RESOLVED_CONFIG" >&2
            return 1
        fi

        CONTAINER_RESOLVED_CONFIG="${RESOLVED_CONFIG/$REPO/\/workspace\/IEA_G1}"

        # Baseline replays the config's own task (no PPO updates), with trace.
        BASELINE_TASK="$(python3 - "$RESOLVED_CONFIG" <<'PYTASK'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    config = yaml.safe_load(stream)

task = config.get("task", {}).get("id")
allowed = {
    "Unitree-IEA-G1-29dof-Stairs-v0",
    "Unitree-IEA-G1-29dof-Stairs-Footsteps-v0",
    "Unitree-IEA-G1-29dof-Stairs-Flat-Footsteps-v0",
}
if task not in allowed:
    raise SystemExit(f"Unsupported baseline task: {task!r}")
print(task)
PYTASK
)"
        BASELINE_TRACE=(--trace)
    else
        BASELINE_ID="t0_unitree_velocity_prior_${STAMP}"
    fi

    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/baselines/${BASELINE_ID}/side"
    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    mkdir -p "$HOST_OUTPUT"

    if [ -n "$RUN_DIR" ]; then
        T0_LOG="${RUN_DIR}/t0_console.log"
    else
        T0_LOG="${HOST_OUTPUT}/t0_console.log"
    fi

    PROJECT_COMMIT="$(git rev-parse HEAD)"
    ISAACLAB_COMMIT="3c6e67bb5c7ada942a6d1884ab69338f57596f77"
    UNITREE_RL_COMMIT="4960b84732b0c2ec593dccbfe963fda1bcd7b1e3"
    UNITREE_DIFF_SHA256="54a60bd3ed9de27514530c82936cb43e6b1c5074fee173e81ee271b7ca238b1f"

    POLICY_ONNX="/workspace/unitree_rl_lab/deploy/robots/g1_29dof/config/policy/velocity/v0/exported/policy.onnx"

    echo "========================================"
    echo " G1 T0 LOCOMOTION PRIOR BASELINE"
    echo "========================================"
    echo "Baseline:    $BASELINE_ID"
    echo "Task:        $BASELINE_TASK"
    echo "Policy:      Unitree-G1-29dof-Velocity"
    echo "PPO updates: 0"
    echo "Exploration: deterministic inference"
    echo "View:        side"
    if [ -n "$CONFIG" ]; then
        echo "Config:      $CONFIG"
        echo "Resolved:    $RESOLVED_CONFIG"
    fi
    echo "Log:         $T0_LOG"
    echo

    local -a RECORD_CMD=(
        docker exec
        --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab
        --workdir /workspace/IEA_G1
        "$CONTAINER"
        /workspace/isaaclab/isaaclab.sh -p
        simulation/isaac_lab/g1_stairs/scripts/visualization/record_view.py
        --task "$BASELINE_TASK"
        "${BASELINE_TRACE[@]}"
        --view side
        --output_dir "$OUTPUT_DIR"
        --video_length 600
        --seed 42
        --num_envs 1
        --policy_onnx "$POLICY_ONNX"
        --project_commit "$PROJECT_COMMIT"
        --isaaclab_commit "$ISAACLAB_COMMIT"
        --unitree_rl_commit "$UNITREE_RL_COMMIT"
        --unitree_diff_sha256 "$UNITREE_DIFF_SHA256"
        --headless
        --device cuda:0
    )

    if [ -n "$CONTAINER_RESOLVED_CONFIG" ]; then
        RECORD_CMD+=(
            --resolved_config "$CONTAINER_RESOLVED_CONFIG"
        )
    fi

    "${RECORD_CMD[@]}" 2>&1 | tee "$T0_LOG"

    VIDEO_FILE="$(
        find "$HOST_OUTPUT" -type f -name '*.mp4' -print -quit 2>/dev/null || true
    )"

    if [ -z "$VIDEO_FILE" ]; then
        echo "ERROR: baseline completed without producing an MP4:" >&2
        echo "  $HOST_OUTPUT" >&2
        return 1
    fi

    METADATA_FILE="${HOST_OUTPUT}/metadata.json"
    if [ ! -f "$METADATA_FILE" ]; then
        echo "ERROR: baseline metadata is missing:" >&2
        echo "  $METADATA_FILE" >&2
        return 1
    fi

    python3 - "$METADATA_FILE" "$RESOLVED_CONFIG" <<'PY'
import json
import sys
from pathlib import Path

metadata_path = Path(sys.argv[1])
resolved_value = sys.argv[2]
metadata = json.loads(metadata_path.read_text(encoding="utf-8"))

if metadata.get("completed") is not True:
    raise SystemExit(f"baseline metadata is not complete: {metadata_path}")
if int(metadata.get("completed_steps", 0)) <= 0:
    raise SystemExit(f"baseline metadata has no completed steps: {metadata_path}")

initialization = metadata.get("policy_initialization") or {}
if initialization.get("new_columns_max_abs") != 0.0:
    raise SystemExit(
        "baseline policy transfer did not zero new observation columns: "
        f"{initialization.get('new_columns_max_abs')}"
    )

if resolved_value:
    import yaml

    resolved_path = Path(resolved_value)
    resolved = yaml.safe_load(resolved_path.read_text(encoding="utf-8"))
    expected = resolved.get("policy_initialization", {})

    for key in (
        "locomotion_observations",
        "actor_height_scan_observations",
        "explicit_geometry_observations",
        "stair_observations",
        "actions",
    ):
        if key not in expected:
            continue
        if initialization.get(key) != expected[key]:
            raise SystemExit(
                f"baseline policy contract mismatch for {key}: "
                f"expected {expected[key]!r}, "
                f"got {initialization.get(key)!r}"
            )
PY

    echo
    echo "Baseline output:"
    echo "  $HOST_OUTPUT"
    echo "Video:"
    echo "  $VIDEO_FILE"
    echo "Metadata:"
    echo "  $METADATA_FILE"
    echo "Log:"
    echo "  $T0_LOG"
}

cmd_evaluate() {
    if [ $# -ne 1 ]; then
        echo "Usage: simctl evaluate <checkpoint>"
        exit 1
    fi

    CHECKPOINT="$1"

    if ! [[ "$CHECKPOINT" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint must be an integer, for example: 1999"
        exit 1
    fi

    RUN_ID="$(current_run)"
    TRAIN_DIR="$(resolve_train_dir)"
    MODEL="${TRAIN_DIR}/model_${CHECKPOINT}.pt"

    if [ ! -f "$MODEL" ]; then
        echo "Checkpoint not found:"
        echo "  $MODEL"
        exit 1
    fi

    ensure_container_running

    CONTAINER_MODEL="${MODEL/$REPO/\/workspace\/IEA_G1}"
    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/evaluation/${RUN_ID}/model_${CHECKPOINT}_seed42"

    RESOLVED_CONFIG="${REPO}/experiments/g1_stairs/runs/${RUN_ID}/resolved_config.yaml"

    if [ ! -f "$RESOLVED_CONFIG" ]; then
        echo "Resolved config not found:"
        echo "  $RESOLVED_CONFIG"
        exit 1
    fi

    CONTAINER_RESOLVED_CONFIG="${RESOLVED_CONFIG/$REPO/\/workspace\/IEA_G1}"

    echo "========================================"
    echo " G1 CHECKPOINT EVALUATION"
    echo "========================================"
    echo "Run:        $RUN_ID"
    echo "Checkpoint: model_${CHECKPOINT}.pt"
    echo "Seed:       42"
    echo "Max steps:  900"
    echo

    docker exec \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      "$CONTAINER" \
      bash -lc "
cd /workspace/IEA_G1

/workspace/isaaclab/isaaclab.sh -p \
  simulation/isaac_lab/g1_stairs/scripts/evaluation/evaluate_isaac_stairs.py \
  --task Unitree-IEA-G1-29dof-Stairs-v0 \
  --checkpoint '${CONTAINER_MODEL}' \
  --resolved-config '${CONTAINER_RESOLVED_CONFIG}' \
  --output-dir '${OUTPUT_DIR}' \
  --max-steps 900 \
  --seed 42 \
  --headless \
  --device cuda:0
"

    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    echo
    echo "Evaluation output:"
    if [ -d "$HOST_OUTPUT" ]; then
        find "$HOST_OUTPUT" -maxdepth 2 -type f -printf '%p\n' | sort
    else
        echo "  Output directory was not created."
    fi
}

cmd_info() {
    RUN_ID="$(current_run)"

    echo "Current run:"
    echo "  $RUN_ID"
    echo
    echo "Run directory:"
    echo "  ${RUN_ROOT}/${RUN_ID}"
    echo
    echo "Launcher log:"
    echo "  ${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"
    echo
    echo "Project commit:"
    git rev-parse HEAD
    echo
    echo "Git status:"
    if [ -z "$(git status --porcelain)" ]; then
        echo "  clean"
    else
        git status --short
    fi
}

case "${1:-help}" in
    train)
        shift
        cmd_train "$@"
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    diagnose)
        cmd_diagnose
        ;;
    mechanics)
        cmd_mechanics
        ;;
    health)
        shift
        cmd_health "$@"
        ;;
    runs)
        cmd_runs
        ;;
    use)
        shift
        cmd_use "$@"
        ;;
    tensorboard)
        shift
        cmd_tensorboard "$@"
        ;;
    video)
        shift
        cmd_video "$@"
        ;;
    baseline)
        shift
        cmd_baseline "$@"
        ;;
    evaluate)
        shift
        cmd_evaluate "$@"
        ;;
    info)
        cmd_info
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        echo
        usage
        exit 1
        ;;
esac
