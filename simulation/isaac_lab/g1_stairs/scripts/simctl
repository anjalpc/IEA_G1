#!/usr/bin/env bash
set -euo pipefail

REPO="/home/ubuntu/workspace/IEA_G1"
WORKSPACE="/home/ubuntu/workspace"

EXPERIMENT_ROOT="${REPO}/experiments/g1_stairs"
RUN_ROOT="${EXPERIMENT_ROOT}/runs"
LOG_ROOT="${EXPERIMENT_ROOT}/logs"
OUTPUT_ROOT="${EXPERIMENT_ROOT}/outputs"
STATE_DIR="${WORKSPACE}/state/IEA_G1"
LAUNCHER_LOG_DIR="${STATE_DIR}/launcher_logs"
CURRENT_RUN="${STATE_DIR}/current_run"
CURRENT_PID="${STATE_DIR}/current_pid"
TRAIN_WRAPPER="${REPO}/simulation/isaac_lab/g1_stairs/scripts/training/run_aws_recorded_experiment.sh"
TB_PORT=6006
CONTAINER="isaac-lab-fixed"

ensure_state_dirs() {
    mkdir -p "$STATE_DIR" "$LAUNCHER_LOG_DIR"
}

cd "$REPO"

usage() {
    cat <<USAGE
Usage:
  simctl train <config.yaml>
  simctl status
  simctl info
  simctl runs
  simctl use <run_id>
  simctl tensorboard
  simctl video <checkpoint>
  simctl evaluate <checkpoint>
  simctl help
USAGE
}

ensure_container_running() {
    if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
        echo "Required container does not exist: $CONTAINER" >&2
        echo "Refusing to recreate it automatically." >&2
        exit 1
    fi

    RUNNING="$(
        docker inspect \
          --format '{{.State.Running}}' \
          "$CONTAINER"
    )"

    if [ "$RUNNING" != "true" ]; then
        echo "Starting container: $CONTAINER"

        docker start "$CONTAINER" >/dev/null

        for _ in {1..10}; do
            RUNNING="$(
                docker inspect \
                  --format '{{.State.Running}}' \
                  "$CONTAINER"
            )"

            if [ "$RUNNING" = "true" ]; then
                echo "Container running."
                return 0
            fi

            sleep 1
        done

        echo "Container failed to start: $CONTAINER" >&2
        exit 1
    fi
}

current_run() {
    if [ ! -f "$CURRENT_RUN" ]; then
        echo "No current training run recorded." >&2
        exit 1
    fi
    cat "$CURRENT_RUN"
}

train_dir_to_host() {
    local train_dir="$1"

    case "$train_dir" in
        /workspace/IEA_G1/experiments/g1_stairs/logs/*)
            echo "${train_dir/\/workspace\/IEA_G1/$REPO}"
            ;;
        /workspace/IEA_G1/logs/*)
            local relative="${train_dir#/workspace/IEA_G1/logs/}"
            echo "${LOG_ROOT}/${relative}"
            ;;
        *)
            echo "Unsupported training directory: $train_dir" >&2
            return 1
            ;;
    esac
}

cmd_runs() {
    echo "========================================"
    echo " AVAILABLE RECORDED RUNS"
    echo "========================================"

    CURRENT=""
    if [ -f "$CURRENT_RUN" ]; then
        CURRENT="$(cat "$CURRENT_RUN")"
    fi

    found=0

    for dir in "$RUN_ROOT"/*; do
        [ -d "$dir" ] || continue

        run_id="$(basename "$dir")"
        manifest="$dir/run_manifest.yaml"

        if [ -f "$manifest" ]; then
            status="$(
                grep -E '^  status:' "$manifest" \
                | tail -n 1 \
                | sed 's/^  status:[[:space:]]*//' \
                || true
            )"
        else
            status="unknown"
        fi

        marker=" "
        if [ "$run_id" = "$CURRENT" ]; then
            marker="*"
        fi

        printf "%s %-55s %s\n" "$marker" "$run_id" "${status:-unknown}"
        found=1
    done

    if [ "$found" -eq 0 ]; then
        echo "No recorded runs found."
    fi

    echo
    echo "* = currently selected run"
}

cmd_use() {
    if [ $# -ne 1 ]; then
        echo "Usage: simctl use <run_id>"
        exit 1
    fi

    RUN_ID="$1"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"

    if [ ! -d "$RUN_DIR" ]; then
        echo "Run not found:"
        echo "  $RUN_DIR"
        echo
        echo "Use 'simctl runs' to list available runs."
        exit 1
    fi

    ensure_state_dirs
    printf '%s\n' "$RUN_ID" > "$CURRENT_RUN"

    echo "Selected run:"
    echo "  $RUN_ID"
    echo
    echo "Commands such as status, video and evaluate now use this run."
}

cmd_train() {
    if [ $# -lt 1 ]; then
        echo "Missing experiment config."
        usage
        exit 1
    fi

    CONFIG="$1"

    if [ ! -f "$CONFIG" ]; then
        echo "Config not found: $CONFIG"
        exit 1
    fi

    if [ -n "$(git status --porcelain)" ]; then
        echo "Refusing to train from a dirty worktree."
        git status --short
        exit 1
    fi

    ensure_container_running

    BASE="$(basename "$CONFIG" .yaml)"
    RUN_ID="${BASE}_$(date -u +%Y%m%d_%H%M%S)"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    ensure_state_dirs
    printf '%s\n' "$RUN_ID" > "$CURRENT_RUN"

    echo "========================================"
    echo " G1 STAIR TRAINING"
    echo "========================================"
    echo "Config: $CONFIG"
    echo "Run:    $RUN_ID"
    echo "Log:    $LOG"
    echo

    nohup "$TRAIN_WRAPPER" \
        "$CONFIG" \
        --run-id "$RUN_ID" \
        > "$LOG" 2>&1 &

    PID=$!

    echo "$PID" > "$CURRENT_PID"

    echo "Started."
    echo "PID: $PID"
    echo
    echo "Use:"
    echo "  simulation/isaac_lab/g1_stairs/scripts/simctl status"
}

cmd_status() {
    RUN_ID="$(current_run)"
    RUN_DIR="${RUN_ROOT}/${RUN_ID}"
    MANIFEST="${RUN_DIR}/run_manifest.yaml"
    METRICS="${RUN_DIR}/training_metrics.csv"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    echo "========================================"
    echo " G1 TRAINING STATUS"
    echo "========================================"
    echo "Run: $RUN_ID"

    if [ -f "$MANIFEST" ]; then
        STATUS="$(grep -E '^  status:' "$MANIFEST" | tail -n 1 | sed 's/^  status:[[:space:]]*//')"
        EXIT_CODE="$(grep -E '^  exit_code:' "$MANIFEST" | tail -n 1 | sed 's/^  exit_code:[[:space:]]*//' || true)"
        echo "Status: ${STATUS:-unknown}"
        [ -n "${EXIT_CODE:-}" ] && echo "Exit code: $EXIT_CODE"
    else
        echo "Status: starting"
    fi

    if [ -f "$METRICS" ]; then
        python3 - "$METRICS" "${RUN_DIR}/resolved_config.yaml" "$MANIFEST" <<'PY'
import csv
import re
import sys
from pathlib import Path

metrics = Path(sys.argv[1])
config = Path(sys.argv[2])
manifest = Path(sys.argv[3])

with metrics.open(newline="") as f:
    rows = list(csv.DictReader(f))

if not rows:
    raise SystemExit

row = rows[-1]

iteration = int(float(row["iteration"]))
wall = float(row.get("wall_time_s") or 0)
reward = row.get("episode_return_mean", "")
max_x = row.get("maximum_x_mean_m", "")
step = row.get("maximum_step_reached_mean", "")
platform = row.get("platform_reached_rate", "")
action_rate = row.get("action_rate_mean", "")
power = row.get("mechanical_power_mean", "")

# The run manifest is authoritative because it records the command
# that was actually executed.
target = None

if manifest.exists():
    manifest_text = manifest.read_text()
    match = re.search(
        r"(?m)^\s*-\s*--max_iterations\s*$\n"
        r"^\s*-\s*['\"]?(\d+)['\"]?\s*$",
        manifest_text,
    )
    if match:
        target = int(match.group(1))

# Fallback for older manifests. The top-level training value is the
# first maximum_iterations entry in our resolved experiment schema.
if target is None and config.exists():
    config_text = config.read_text()
    values = re.findall(r"maximum_iterations:\s*(\d+)", config_text)
    if values:
        target = int(values[0])

print()
if target:
    completed = iteration + 1
    pct = 100.0 * completed / target
    print(f"Iteration: {iteration}/{target - 1}  ({pct:.1f}%)")

    if wall > 0 and completed > 0:
        eta = wall / completed * max(target - completed, 0)
        h = int(eta // 3600)
        m = int((eta % 3600) // 60)
        s = int(eta % 60)
        print(f"Estimated remaining: {h:02d}:{m:02d}:{s:02d}")
else:
    print(f"Iteration: {iteration}")

if reward:
    print(f"Mean return: {reward}")
if max_x:
    print(f"Maximum X mean: {max_x} m")
if step:
    print(f"Maximum step: {step}")
if platform:
    print(f"Platform reached: {platform}")
if action_rate:
    print(f"Action rate: {action_rate}")
if power:
    print(f"Mechanical power: {power}")
PY
    fi

    echo
    echo "Latest checkpoint:"

    if [ -f "$LOG" ]; then
        TRAIN_DIR="$(
            grep -oE '/workspace/IEA_G1/(experiments/g1_stairs/)?logs/rsl_rl/[^[:space:]]+' "$LOG" \
            | head -n 1 || true
        )"

        if [ -n "$TRAIN_DIR" ]; then
            HOST_DIR="$(train_dir_to_host "$TRAIN_DIR")"

            find "$HOST_DIR" -maxdepth 1 -type f -name 'model_*.pt' \
                2>/dev/null \
                | sed -E 's/.*model_([0-9]+)\.pt/\1 &/' \
                | sort -n \
                | tail -n 1 \
                | cut -d' ' -f2- || true
        else
            echo "Not resolved yet."
        fi
    fi

    echo
    echo "TensorBoard: http://localhost:${TB_PORT}"
    echo "========================================"
}

cmd_tensorboard() {
    ensure_container_running

    if docker exec "$CONTAINER" bash -lc \
        "ps aux | grep '[t]ensorboard.main.*--port ${TB_PORT}'" \
        >/dev/null 2>&1
    then
        echo "TensorBoard already running."
    else
        echo "Starting TensorBoard..."

        docker exec -d \
            "$CONTAINER" \
            bash -lc "
            /workspace/isaaclab/isaaclab.sh -p -m tensorboard.main \
              --logdir /workspace/IEA_G1/experiments/g1_stairs/logs/rsl_rl/unitree_iea_g1_29dof_stairs_v0 \
              --host 0.0.0.0 \
              --port ${TB_PORT} \
              > /tmp/tensorboard.log 2>&1
            "

        sleep 2
        echo "TensorBoard started."
    fi

    echo "Open: http://localhost:${TB_PORT}"
}

resolve_train_dir() {
    RUN_ID="$(current_run)"
    LOG="${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"

    if [ ! -f "$LOG" ]; then
        echo "Launcher log not found: $LOG" >&2
        exit 1
    fi

    TRAIN_DIR="$(
        grep -oE '/workspace/IEA_G1/(experiments/g1_stairs/)?logs/rsl_rl/[^[:space:]]+' "$LOG" \
        | head -n 1 || true
    )"

    if [ -z "$TRAIN_DIR" ]; then
        echo "Could not resolve RSL-RL training directory for run: $RUN_ID" >&2
        exit 1
    fi

    train_dir_to_host "$TRAIN_DIR"
}

cmd_video() {
    if [ $# -ne 1 ]; then
        echo "Usage: simctl video <checkpoint>"
        exit 1
    fi

    CHECKPOINT="$1"

    if ! [[ "$CHECKPOINT" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint must be an integer, for example: 800"
        exit 1
    fi

    RUN_ID="$(current_run)"
    TRAIN_DIR="$(resolve_train_dir)"
    MODEL="${TRAIN_DIR}/model_${CHECKPOINT}.pt"

    if [ ! -f "$MODEL" ]; then
        echo "Checkpoint not found:"
        echo "  $MODEL"
        exit 1
    fi

    ensure_container_running

    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/videos/${RUN_ID}/model_${CHECKPOINT}_side"

    PROJECT_COMMIT="$(git rev-parse HEAD)"
    ISAACLAB_COMMIT="3c6e67bb5c7ada942a6d1884ab69338f57596f77"
    UNITREE_RL_COMMIT="4960b84732b0c2ec593dccbfe963fda1bcd7b1e3"
    UNITREE_DIFF_SHA256="54a60bd3ed9de27514530c82936cb43e6b1c5074fee173e81ee271b7ca238b1f"

    CONTAINER_MODEL="${MODEL/$REPO/\/workspace\/IEA_G1}"

    echo "========================================"
    echo " G1 VIDEO RECORDING"
    echo "========================================"
    echo "Run:        $RUN_ID"
    echo "Checkpoint: model_${CHECKPOINT}.pt"
    echo "View:       side"
    echo

    docker exec \
      --env PYTHONPATH=/workspace/IEA_G1 \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      "$CONTAINER" \
      bash -lc "
cd /workspace/IEA_G1

/workspace/isaaclab/isaaclab.sh -p \
  simulation/isaac_lab/g1_stairs/scripts/visualization/record_view.py \
  --task Unitree-IEA-G1-29dof-Stairs-v0 \
  --view side \
  --output_dir '${OUTPUT_DIR}' \
  --video_length 600 \
  --seed 42 \
  --num_envs 1 \
  --checkpoint '${CONTAINER_MODEL}' \
  --project_commit '${PROJECT_COMMIT}' \
  --isaaclab_commit '${ISAACLAB_COMMIT}' \
  --unitree_rl_commit '${UNITREE_RL_COMMIT}' \
  --unitree_diff_sha256 '${UNITREE_DIFF_SHA256}' \
  --headless \
  --device cuda:0
"

    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    echo
    echo "Video output:"
    find "$HOST_OUTPUT" -type f -name '*.mp4' -print || true
}

cmd_evaluate() {
    if [ $# -ne 1 ]; then
        echo "Usage: simctl evaluate <checkpoint>"
        exit 1
    fi

    CHECKPOINT="$1"

    if ! [[ "$CHECKPOINT" =~ ^[0-9]+$ ]]; then
        echo "Checkpoint must be an integer, for example: 1999"
        exit 1
    fi

    RUN_ID="$(current_run)"
    TRAIN_DIR="$(resolve_train_dir)"
    MODEL="${TRAIN_DIR}/model_${CHECKPOINT}.pt"

    if [ ! -f "$MODEL" ]; then
        echo "Checkpoint not found:"
        echo "  $MODEL"
        exit 1
    fi

    ensure_container_running

    CONTAINER_MODEL="${MODEL/$REPO/\/workspace\/IEA_G1}"
    OUTPUT_DIR="/workspace/IEA_G1/experiments/g1_stairs/outputs/evaluation/${RUN_ID}/model_${CHECKPOINT}_seed42"

    echo "========================================"
    echo " G1 CHECKPOINT EVALUATION"
    echo "========================================"
    echo "Run:        $RUN_ID"
    echo "Checkpoint: model_${CHECKPOINT}.pt"
    echo "Seed:       42"
    echo "Max steps:  900"
    echo

    docker exec \
      --env PYTHONPATH=/workspace/IEA_G1 \
      --env UNITREE_RL_LAB_ROOT=/workspace/unitree_rl_lab \
      "$CONTAINER" \
      bash -lc "
cd /workspace/IEA_G1

/workspace/isaaclab/isaaclab.sh -p \
  simulation/isaac_lab/g1_stairs/scripts/evaluation/evaluate_isaac_stairs.py \
  --task Unitree-IEA-G1-29dof-Stairs-v0 \
  --checkpoint '${CONTAINER_MODEL}' \
  --output-dir '${OUTPUT_DIR}' \
  --max-steps 900 \
  --seed 42 \
  --headless \
  --device cuda:0
"

    HOST_OUTPUT="${OUTPUT_DIR/\/workspace\/IEA_G1/$REPO}"

    echo
    echo "Evaluation output:"
    if [ -d "$HOST_OUTPUT" ]; then
        find "$HOST_OUTPUT" -maxdepth 2 -type f -printf '%p\n' | sort
    else
        echo "  Output directory was not created."
    fi
}

cmd_info() {
    RUN_ID="$(current_run)"

    echo "Current run:"
    echo "  $RUN_ID"
    echo
    echo "Run directory:"
    echo "  ${RUN_ROOT}/${RUN_ID}"
    echo
    echo "Launcher log:"
    echo "  ${LAUNCHER_LOG_DIR}/${RUN_ID}_launcher.log"
    echo
    echo "Project commit:"
    git rev-parse HEAD
    echo
    echo "Git status:"
    if [ -z "$(git status --porcelain)" ]; then
        echo "  clean"
    else
        git status --short
    fi
}

case "${1:-help}" in
    train)
        shift
        cmd_train "$@"
        ;;
    status)
        cmd_status
        ;;
    runs)
        cmd_runs
        ;;
    use)
        shift
        cmd_use "$@"
        ;;
    tensorboard)
        cmd_tensorboard
        ;;
    video)
        shift
        cmd_video "$@"
        ;;
    evaluate)
        shift
        cmd_evaluate "$@"
        ;;
    info)
        cmd_info
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        echo
        usage
        exit 1
        ;;
esac
