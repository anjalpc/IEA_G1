<mujoco model="generic_handshake_surrogate">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7"/>
  </visual>

  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.18 0.2 0.22 1"/>

    <body name="stand" pos="0 0 0.85">
      <geom type="box" size="0.18 0.12 0.32" rgba="0.2 0.35 0.55 1"/>
      <body name="upper_arm" pos="0 -0.16 0.2">
        <joint name="shoulder" type="hinge" axis="0 1 0" range="-1.2 1.2" damping="2"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.38" size="0.055" rgba="0.65 0.68 0.72 1"/>
        <body name="forearm" pos="0 0 -0.38">
          <joint name="elbow" type="hinge" axis="0 1 0" range="-1.6 0.2" damping="2"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.34" size="0.045" rgba="0.6 0.63 0.68 1"/>
          <body name="palm" pos="0 0 -0.36">
            <geom type="box" size="0.07 0.025 0.09" rgba="0.25 0.45 0.65 1"/>

            <body name="thumb" pos="0.075 0 -0.02">
              <joint name="thumb_joint" type="hinge" axis="0 1 0" range="0 1" damping="0.3"/>
              <geom type="capsule" fromto="0 0 0 0.06 0 -0.04" size="0.012"/>
            </body>
            <body name="index" pos="0.05 0 -0.085">
              <joint name="index_joint" type="hinge" axis="1 0 0" range="0 1" damping="0.3"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.10" size="0.011"/>
            </body>
            <body name="middle" pos="0.017 0 -0.09">
              <joint name="middle_joint" type="hinge" axis="1 0 0" range="0 1" damping="0.3"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.11" size="0.011"/>
            </body>
            <body name="ring" pos="-0.017 0 -0.09">
              <joint name="ring_joint" type="hinge" axis="1 0 0" range="0 1" damping="0.3"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.105" size="0.011"/>
            </body>
            <body name="pinky" pos="-0.05 0 -0.08">
              <joint name="pinky_joint" type="hinge" axis="1 0 0" range="0 1" damping="0.3"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.09" size="0.010"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_position" joint="shoulder" kp="40"/>
    <position name="elbow_position" joint="elbow" kp="40"/>
    <position name="thumb_position" joint="thumb_joint" kp="8"/>
    <position name="index_position" joint="index_joint" kp="8"/>
    <position name="middle_position" joint="middle_joint" kp="8"/>
    <position name="ring_position" joint="ring_joint" kp="8"/>
    <position name="pinky_position" joint="pinky_joint" kp="8"/>
  </actuator>
</mujoco>
