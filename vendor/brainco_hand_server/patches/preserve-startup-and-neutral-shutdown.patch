+void restore_right_hand_neutral(DeviceHandler* handle, uint8_t slave_id) {
+    constexpr int ramp_steps = 19;
+    constexpr auto step_period = std::chrono::milliseconds(40);
+    const uint16_t target[6] = {399, 399, 50, 50, 49, 50};
+    const uint16_t speeds[6] = {1000, 1000, 1000, 1000, 1000, 1000};
+
+    auto status = stark_get_motor_status(handle, slave_id);
+    if (!status) {
+        spdlog::error(
+            "Could not read right-hand state; neutral shutdown skipped");
+        return;
+    }
+
+    uint16_t initial[6];
+    for (int i = 0; i < 6; ++i) {
+        initial[i] = status->positions[i];
+    }
+    free_motor_status_data(status);
+
+    spdlog::info("Restoring right hand to calibrated neutral posture");
+
+    for (int step = 1; step <= ramp_steps; ++step) {
+        uint16_t positions[6];
+
+        for (int i = 0; i < 6; ++i) {
+            const int delta =
+                static_cast<int>(target[i]) - static_cast<int>(initial[i]);
+            positions[i] = static_cast<uint16_t>(
+                static_cast<int>(initial[i]) +
+                (delta * step) / ramp_steps);
+        }
+
+        stark_set_finger_positions_and_speeds(
+            handle, slave_id, positions, speeds, 6);
+        std::this_thread::sleep_for(step_period);
+    }
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    spdlog::info("Right-hand neutral shutdown command complete");
+}
 
